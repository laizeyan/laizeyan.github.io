      // 密码生成器
      const pwdLen = document.getElementById("pwd-len") as HTMLInputElement | null;
      const pwdLenVal = document.getElementById("pwd-len-val");
      const pwdUpper = document.getElementById("pwd-upper") as HTMLInputElement | null;
      const pwdLower = document.getElementById("pwd-lower") as HTMLInputElement | null;
      const pwdDigits = document.getElementById("pwd-digits") as HTMLInputElement | null;
      const pwdSymbols = document.getElementById("pwd-symbols") as HTMLInputElement | null;
      const pwdNoAmbig = document.getElementById("pwd-no-ambig") as HTMLInputElement | null;
      const pwdOut = document.getElementById("pwd-single-output") as HTMLInputElement | null;
      const strengthFill = document.getElementById("strength-fill");
      const strengthText = document.getElementById("strength-text");

      pwdLen?.addEventListener("input", () => {
        if (pwdLenVal && pwdLen) pwdLenVal.textContent = pwdLen.value;
        runGeneratePassword();
      });

      [pwdUpper, pwdLower, pwdDigits, pwdSymbols, pwdNoAmbig].forEach((chk) => {
        chk?.addEventListener("change", runGeneratePassword);
      });

      function runGeneratePassword() {
        if (!pwdOut) return;
        const len = parseInt(pwdLen?.value || "16", 10);
        let uChars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ";
        let lChars = "abcdefghijklmnopqrstuvwxyz";
        let dChars = "0123456789";
        let sChars = "!@#$%^&*()_+-=[]{}|;:,.<>?";

        if (pwdNoAmbig?.checked) {
          uChars = uChars.replace(/[IO]/g, "");
          lChars = lChars.replace(/[lo]/g, "");
          dChars = dChars.replace(/[01]/g, "");
          sChars = sChars.replace(/[`~|]/g, "");
        }

        let pool = "";
        const guaranteed: string[] = [];

        if (pwdUpper?.checked) { pool += uChars; guaranteed.push(uChars[Math.floor(Math.random() * uChars.length)]); }
        if (pwdLower?.checked) { pool += lChars; guaranteed.push(lChars[Math.floor(Math.random() * lChars.length)]); }
        if (pwdDigits?.checked) { pool += dChars; guaranteed.push(dChars[Math.floor(Math.random() * dChars.length)]); }
        if (pwdSymbols?.checked) { pool += sChars; guaranteed.push(sChars[Math.floor(Math.random() * sChars.length)]); }

        if (!pool) {
          pool = lChars + dChars;
          guaranteed.push(lChars[0]);
        }

        const res: string[] = [...guaranteed];
        const randArray = new Uint32Array(len);
        crypto.getRandomValues(randArray);

        for (let i = res.length; i < len; i++) {
          res.push(pool[randArray[i] % pool.length]);
        }

        // Fisher-Yates 洗牌打乱保证随机性
        for (let i = res.length - 1; i > 0; i--) {
          const j = randArray[i] % (i + 1);
          const temp = res[i];
          res[i] = res[j];
          res[j] = temp;
        }

        const password = res.join("");
        pwdOut.value = password;

        // 密码强度与信息熵计算
        const entropy = Math.round(len * Math.log2(pool.length));
        if (strengthFill && strengthText) {
          if (entropy < 45) {
            strengthFill.style.width = "25%";
            strengthFill.style.backgroundColor = "#e53935";
            strengthText.textContent = `弱 (${entropy} bits)`;
          } else if (entropy < 65) {
            strengthFill.style.width = "50%";
            strengthFill.style.backgroundColor = "#f59e0b";
            strengthText.textContent = `中等 (${entropy} bits)`;
          } else if (entropy < 85) {
            strengthFill.style.width = "75%";
            strengthFill.style.backgroundColor = "#10b981";
            strengthText.textContent = `强 (${entropy} bits)`;
          } else {
            strengthFill.style.width = "100%";
            strengthFill.style.backgroundColor = "#06b6d4";
            strengthText.textContent = `极高强度 (${entropy} bits)`;
          }
        }
      }

      document.getElementById("btn-gen-pwd")?.addEventListener("click", runGeneratePassword);

