      // ----------------------------------------------------
      function showStatus(elemId: string, msg: string, isError = false) {
        const el = document.getElementById(elemId);
        if (!el) return;
        el.textContent = msg;
        el.className = `status-msg ${isError ? "status-err" : "status-ok"}`;
        setTimeout(() => {
          if (el && el.textContent === msg) el.textContent = "";
        }, 3500);
      }

      function escapeHtml(s: string) {
        return (s || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;");
      }

      function copyWithFeedback(button: HTMLElement | null, text: string, statusId?: string, msg = "已复制到剪贴板！") {
        if (!button || !text) return;
        navigator.clipboard.writeText(text).then(() => {
          button.classList.add("btn-copied");
          const origText = button.textContent;
          button.textContent = "已复制 ✓";
          setTimeout(() => {
            button.textContent = origText;
            button.classList.remove("btn-copied");
          }, 1500);
          if (statusId) showStatus(statusId, msg);
        }).catch(() => {
          if (statusId) showStatus(statusId, "复制失败，请手动选中文本复制", true);
        });
      }

      function attachStats(input: HTMLTextAreaElement | HTMLInputElement | HTMLElement | null, statsElId: string) {
        const statsEl = document.getElementById(statsElId);
        if (!input || !statsEl) return;
        const update = () => {
          const val = "value" in input ? (input as HTMLInputElement).value : (input.textContent || "");
          const chars = val.length;
          const bytes = new TextEncoder().encode(val).length;
          statsEl.textContent = `${chars.toLocaleString()} 字符 · ${bytes.toLocaleString()} 字节`;
        };
        input.addEventListener("input", update);
        update();
      }

