---
// src/pages/tools.astro
import Base from "../layouts/Base.astro";

const toolCategories = [
  {
    name: "数据转换",
    tools: [
      { id: "json", name: "JSON 格式化", icon: "{ }" },
      { id: "base64", name: "Base64 编解码", icon: "64" },
      { id: "url", name: "URL 编解码", icon: "%" },
      { id: "unicode", name: "Unicode 转换", icon: "U+" },
    ],
  },
  {
    name: "时间与时区",
    tools: [
      { id: "timestamp", name: "时间戳转换", icon: "⏱" },
    ],
  },
  {
    name: "文本分析",
    tools: [
      { id: "wordcount", name: "字数与阅读统计", icon: "Aa" },
      { id: "diff", name: "文本差异对比", icon: "±" },
      { id: "regex", name: "正则表达式测试", icon: ".*" },
    ],
  },
  {
    name: "开发小件",
    tools: [
      { id: "avatar", name: "GitHub 像素头像", icon: "👾" },
    ],
  },
];
---

<Base
  title="实用工具箱 · Ze'Yan"
  description="开箱即用的前端开发工具箱：JSON格式化、Base64/URL转换、时间戳、正则测试、文本对比等"
>
  <article class="prose tools-page reveal">
    <header class="tools-head">
      <div class="tools-head-accent" aria-hidden="true"></div>
      <p class="section-kicker">开发者利器</p>
      <h1>实用工具</h1>
      <p class="lead">
        轻量高效的纯前端开发工具套件，数据全在本地浏览器完成处理，零泄露风险。
      </p>
    </header>

    <hr class="rule" />

    <!-- 工具箱交互框架 -->
    <div class="toolbox-layout">
      <!-- 侧边 / 顶部工具快捷切换菜单 -->
      <aside class="toolbox-sidebar" aria-label="工具列表">
        {
          toolCategories.map((cat) => (
            <div class="tool-cat-group">
              <span class="cat-title">{cat.name}</span>
              <nav class="tool-nav">
                {cat.tools.map((t) => (
                  <button
                    class="tool-btn"
                    data-tool-target={t.id}
                    id={`btn-${t.id}`}
                    aria-label={t.name}
                  >
                    <span class="tool-icon" aria-hidden="true">{t.icon}</span>
                    <span class="tool-name">{t.name}</span>
                  </button>
                ))}
              </nav>
            </div>
          ))
        }
      </aside>

      <!-- 工具主操作区 -->
      <main class="toolbox-panel" id="toolbox-active-panel">
        <!-- 1. JSON 格式化工具 -->
        <section class="tool-section" id="section-json">
          <div class="tool-header">
            <h2>JSON 格式化与压缩</h2>
            <div class="tool-actions">
              <label class="action-label">
                缩进
                <select id="json-indent" class="select-sm">
                  <option value="2">2 空格</option>
                  <option value="4">4 空格</option>
                  <option value="tabs">Tab</option>
                </select>
              </label>
              <button class="btn btn-sm btn-primary" id="btn-json-format">格式化</button>
              <button class="btn btn-sm btn-secondary" id="btn-json-minify">压缩单行</button>
              <button class="btn btn-sm btn-secondary" id="btn-json-copy">复制结果</button>
              <button class="btn btn-sm btn-outline" id="btn-json-sample">示例</button>
              <button class="btn btn-sm btn-outline" id="btn-json-clear">清空</button>
            </div>
          </div>
          <div class="editor-grid">
            <div class="editor-col">
              <span class="col-kicker">输入 JSON</span>
              <textarea id="json-input" class="code-area" placeholder="在此粘贴或输入 JSON 数据，或点击上方「示例」..."></textarea>
            </div>
            <div class="editor-col">
              <span class="col-kicker">处理结果</span>
              <pre id="json-output" class="code-area code-result"></pre>
            </div>
          </div>
          <p id="json-status" class="status-msg"></p>
        </section>

        <!-- 2. Base64 编解码 -->
        <section class="tool-section" id="section-base64" style="display: none;">
          <div class="tool-header">
            <h2>Base64 编解码 (支持 UTF-8)</h2>
            <div class="tool-actions">
              <button class="btn btn-sm btn-primary" id="btn-b64-encode">文本 ➔ Base64</button>
              <button class="btn btn-sm btn-primary" id="btn-b64-decode">Base64 ➔ 文本</button>
              <button class="btn btn-sm btn-secondary" id="btn-b64-copy">复制结果</button>
              <button class="btn btn-sm btn-outline" id="btn-b64-sample">示例</button>
              <button class="btn btn-sm btn-outline" id="btn-b64-clear">清空</button>
            </div>
          </div>
          <div class="editor-grid">
            <div class="editor-col">
              <span class="col-kicker">原始输入</span>
              <textarea id="b64-input" class="code-area" placeholder="输入要编码的明文，或要解码的 Base64 字符串..."></textarea>
            </div>
            <div class="editor-col">
              <span class="col-kicker">转换输出</span>
              <textarea id="b64-output" class="code-area" readonly placeholder="处理结果将在此显示..."></textarea>
            </div>
          </div>
          <p id="b64-status" class="status-msg"></p>
        </section>

        <!-- 3. URL 编解码 -->
        <section class="tool-section" id="section-url" style="display: none;">
          <div class="tool-header">
            <h2>URL 编解码</h2>
            <div class="tool-actions">
              <button class="btn btn-sm btn-primary" id="btn-url-encode">URL 编码</button>
              <button class="btn btn-sm btn-primary" id="btn-url-decode">URL 解码</button>
              <button class="btn btn-sm btn-secondary" id="btn-url-copy">复制结果</button>
              <button class="btn btn-sm btn-outline" id="btn-url-sample">示例</button>
              <button class="btn btn-sm btn-outline" id="btn-url-clear">清空</button>
            </div>
          </div>
          <div class="editor-grid">
            <div class="editor-col">
              <span class="col-kicker">待处理 URL / 参数文本</span>
              <textarea id="url-input" class="code-area" placeholder="输入 URL 或 query 字符串..."></textarea>
            </div>
            <div class="editor-col">
              <span class="col-kicker">转换结果</span>
              <textarea id="url-output" class="code-area" readonly placeholder="输出结果..."></textarea>
            </div>
          </div>
          <p id="url-status" class="status-msg"></p>
        </section>

        <!-- 4. Unicode 转换 -->
        <section class="tool-section" id="section-unicode" style="display: none;">
          <div class="tool-header">
            <h2>Unicode 互转 (\\uXXXX)</h2>
            <div class="tool-actions">
              <button class="btn btn-sm btn-primary" id="btn-uni-to-u">文本 ➔ Unicode</button>
              <button class="btn btn-sm btn-primary" id="btn-u-to-text">Unicode ➔ 文本</button>
              <button class="btn btn-sm btn-secondary" id="btn-uni-copy">复制结果</button>
              <button class="btn btn-sm btn-outline" id="btn-uni-sample">示例</button>
              <button class="btn btn-sm btn-outline" id="btn-uni-clear">清空</button>
            </div>
          </div>
          <div class="editor-grid">
            <div class="editor-col">
              <span class="col-kicker">输入文本 / 编码</span>
              <textarea id="uni-input" class="code-area" placeholder="输入中文或 \\u4e2d\\u6587..."></textarea>
            </div>
            <div class="editor-col">
              <span class="col-kicker">转换结果</span>
              <textarea id="uni-output" class="code-area" readonly placeholder="输出结果..."></textarea>
            </div>
          </div>
          <p id="uni-status" class="status-msg"></p>
        </section>

        <!-- 5. 时间戳与时区时钟 -->
        <section class="tool-section" id="section-timestamp" style="display: none;">
          <div class="tool-header">
            <h2>时间戳转换与世界时钟</h2>
          </div>

          <!-- 当前时间戳看板 -->
          <div class="timestamp-live-box">
            <div class="clock-display">
              <span class="clock-label">当前 Unix 时间戳 (秒)</span>
              <span class="clock-val" id="live-ts-sec">--</span>
            </div>
            <div class="clock-display">
              <span class="clock-label">毫秒 (ms)</span>
              <span class="clock-val" id="live-ts-ms">--</span>
            </div>
            <button class="btn btn-sm btn-outline" id="btn-toggle-clock">暂停时钟</button>
          </div>

          <div class="time-convert-grid">
            <div class="time-card">
              <h3>时间戳 ➔ 北京时间 / ISO</h3>
              <div class="input-row">
                <input type="text" id="ts-to-date-input" class="input-text" placeholder="输入时间戳 (秒或毫秒)" />
                <button class="btn btn-sm btn-primary" id="btn-ts-to-date">转换</button>
                <button class="btn btn-sm btn-secondary" id="btn-ts-fill-now">当前时间戳</button>
              </div>
              <div class="time-res-list" id="ts-to-date-res">
                <p class="res-item"><span>北京时间:</span> <strong id="res-bj">--</strong></p>
                <p class="res-item"><span>UTC 时间:</span> <strong id="res-utc">--</strong></p>
                <p class="res-item"><span>ISO 8601:</span> <strong id="res-iso">--</strong></p>
              </div>
            </div>

            <div class="time-card">
              <h3>日期时间 ➔ 时间戳</h3>
              <div class="input-row">
                <input type="datetime-local" id="date-to-ts-input" class="input-text" step="1" />
                <button class="btn btn-sm btn-primary" id="btn-date-to-ts">转换</button>
                <button class="btn btn-sm btn-secondary" id="btn-date-fill-now">当前时间</button>
              </div>
              <div class="time-res-list">
                <p class="res-item"><span>时间戳 (秒):</span> <strong id="res-sec">--</strong></p>
                <p class="res-item"><span>时间戳 (毫秒):</span> <strong id="res-ms">--</strong></p>
              </div>
            </div>
          </div>
        </section>

        <!-- 6. 字数与阅读统计 -->
        <section class="tool-section" id="section-wordcount" style="display: none;">
          <div class="tool-header">
            <h2>字数与阅读统计</h2>
            <div class="tool-actions">
              <button class="btn btn-sm btn-secondary" id="btn-wc-sample">填入示例</button>
              <button class="btn btn-sm btn-outline" id="btn-wc-clear">清空</button>
            </div>
          </div>
          <textarea id="wc-input" class="code-area wc-area" placeholder="在此输入或粘贴需要统计的文章正文或代码..."></textarea>
          <div class="stat-badges">
            <div class="stat-pill"><span class="pill-k">总字符 (含空格)</span><strong class="pill-v" id="stat-total-chars">0</strong></div>
            <div class="stat-pill"><span class="pill-k">有效字符 (无空格)</span><strong class="pill-v" id="stat-non-space">0</strong></div>
            <div class="stat-pill"><span class="pill-k">中文字符数</span><strong class="pill-v" id="stat-cjk">0</strong></div>
            <div class="stat-pill"><span class="pill-k">英文单词数</span><strong class="pill-v" id="stat-words">0</strong></div>
            <div class="stat-pill"><span class="pill-k">行数</span><strong class="pill-v" id="stat-lines">0</strong></div>
            <div class="stat-pill"><span class="pill-k">预估阅读耗时</span><strong class="pill-v" id="stat-reading-time">0 分钟</strong></div>
          </div>
        </section>

        <!-- 7. 文本差异对比 (Diff) -->
        <section class="tool-section" id="section-diff" style="display: none;">
          <div class="tool-header">
            <h2>文本差异对比 (逐行比对)</h2>
            <div class="tool-actions">
              <button class="btn btn-sm btn-primary" id="btn-run-diff">比较差异</button>
              <button class="btn btn-sm btn-secondary" id="btn-diff-sample">填入对比示例</button>
              <button class="btn btn-sm btn-outline" id="btn-diff-clear">清空</button>
            </div>
          </div>
          <div class="editor-grid">
            <div class="editor-col">
              <span class="col-kicker">原始文本 (Original)</span>
              <textarea id="diff-original" class="code-area" placeholder="输入原始内容，或点击上方「填入对比示例」..."></textarea>
            </div>
            <div class="editor-col">
              <span class="col-kicker">修改后文本 (Modified)</span>
              <textarea id="diff-modified" class="code-area" placeholder="输入修改后内容..."></textarea>
            </div>
          </div>
          <div class="diff-viewer" id="diff-result">
            <p class="diff-placeholder">点击「比较差异」开始对比左右两段文本。</p>
          </div>
        </section>

        <!-- 8. 正则表达式测试器 -->
        <section class="tool-section" id="section-regex" style="display: none;">
          <div class="tool-header">
            <h2>正则表达式测试器</h2>
          </div>
          <div class="regex-input-box">
            <span class="regex-slash">/</span>
            <input type="text" id="regex-pattern" class="regex-pattern-input" value="[\w.-]+@[\w.-]+\.[a-zA-Z]{2,}" placeholder="输入正则表达式" />
            <span class="regex-slash">/</span>
            <input type="text" id="regex-flags" class="regex-flags-input" value="g" placeholder="flags" title="修饰符：g, i, m, s" />
          </div>

          <div class="regex-presets">
            <span class="preset-label">常用模板:</span>
            <button class="preset-btn" data-reg="^1[3-9]\d{9}$" data-flags="g" data-sample="客服电话：13800138000，备用联系号码：15912345678">中国大陆手机号</button>
            <button class="preset-btn" data-reg="[\w.-]+@[\w.-]+\.[a-zA-Z]{2,}" data-flags="g" data-sample="欢迎咨询 contact@example.com 或 feedback@service.cn">电子邮箱 Email</button>
            <button class="preset-btn" data-reg="https?:\/\/[^\s/$.?#].[^\s]*" data-flags="gi" data-sample="官方博客: https://laizeyan.github.io 开源主页: https://github.com/laizeyan">URL 网址</button>
            <button class="preset-btn" data-reg="\b(?:\d{1,3}\.){3}\d{1,3}\b" data-flags="g" data-sample="局域网网关 192.168.1.1 与公共 DNS 8.8.8.8">IPv4 地址</button>
            <button class="preset-btn" data-reg="[\u4e00-\u9fa5]+" data-flags="g" data-sample="极简杂志风 Minimal Magazine Design 2026 优雅设计">中文字符</button>
          </div>

          <div class="editor-grid">
            <div class="editor-col">
              <span class="col-kicker">测试匹配文本</span>
              <textarea id="regex-text" class="code-area" placeholder="在此输入待匹配的测试文本...">欢迎咨询 contact@example.com 或 feedback@service.cn</textarea>
            </div>
            <div class="editor-col">
              <span class="col-kicker">匹配结果回显</span>
              <div id="regex-matches-box" class="code-area code-result regex-results-box">
                <p class="text-muted">等待测试...</p>
              </div>
            </div>
          </div>
        </section>

        <!-- 9. GitHub 像素头像生成器 (Identicon) -->
        <section class="tool-section" id="section-avatar" style="display: none;">
          <div class="tool-header">
            <h2>GitHub 风格对称像素头像生成器</h2>
          </div>
          <div class="avatar-controls">
            <input type="text" id="avatar-input" class="input-text" placeholder="输入任意文本、用户名或邮箱生成专属像素头像..." value="laizeyan" />
            <button class="btn btn-sm btn-primary" id="btn-avatar-random">随机生成</button>
            <button class="btn btn-sm btn-secondary" id="btn-avatar-download">下载 PNG</button>
          </div>

          <div class="avatar-preview-box">
            <canvas id="avatar-canvas" width="240" height="240" class="avatar-canvas"></canvas>
            <p class="avatar-hint">基于 5×5 轴对称哈希算法实时渲染，支持导出高清透明 PNG。</p>
          </div>
        </section>
      </main>
    </div>
  </article>

  <!-- 工具箱前端交互核心逻辑脚本 (标准 Astro 客户端脚本，完美支持 ClientRouter / SPA 路由) -->
  <script>
    let clockInterval: ReturnType<typeof setInterval> | null = null;

    function initToolbox() {
      const toolboxPanel = document.getElementById("toolbox-active-panel");
      if (!toolboxPanel) {
        if (clockInterval) {
          clearInterval(clockInterval);
          clockInterval = null;
        }
        return;
      }

      // 清除旧的定时器避免重复堆叠
      if (clockInterval) {
        clearInterval(clockInterval);
        clockInterval = null;
      }

      // 1. Tab 切换逻辑
      const toolButtons = document.querySelectorAll(".tool-btn");
      const toolSections = document.querySelectorAll<HTMLElement>(".tool-section");

      function activateTool(targetId: string) {
        toolSections.forEach((sec) => (sec.style.display = "none"));
        toolButtons.forEach((btn) => btn.classList.remove("active"));

        const activeSec = document.getElementById(`section-${targetId}`);
        const activeBtn = document.getElementById(`btn-${targetId}`);
        if (activeSec) activeSec.style.display = "block";
        if (activeBtn) activeBtn.classList.add("active");

        history.replaceState(null, "", `#${targetId}`);
      }

      toolButtons.forEach((btn) => {
        btn.addEventListener("click", () => {
          const target = btn.getAttribute("data-tool-target");
          if (target) activateTool(target);
        });
      });

      // 默认激活路由对应工具或 JSON
      const hash = window.location.hash.replace("#", "");
      if (hash && document.getElementById(`section-${hash}`)) {
        activateTool(hash);
      } else {
        activateTool("json");
      }

      // 状态消息提示
      function showStatus(elemId: string, msg: string, isError = false) {
        const el = document.getElementById(elemId);
        if (!el) return;
        el.textContent = msg;
        el.className = `status-msg ${isError ? "status-err" : "status-ok"}`;
        setTimeout(() => {
          if (el) el.textContent = "";
        }, 3000);
      }

      function escapeHtml(s: string) {
        return (s || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;");
      }

      // ==========================================
      // 1. JSON 格式化与压缩
      // ==========================================
      const jsonIn = document.getElementById("json-input") as HTMLTextAreaElement | null;
      const jsonOut = document.getElementById("json-output");
      const jsonIndent = document.getElementById("json-indent") as HTMLSelectElement | null;

      document.getElementById("btn-json-sample")?.addEventListener("click", () => {
        if (!jsonIn) return;
        jsonIn.value = JSON.stringify(
          {
            project: "laizeyan.github.io",
            author: "Ze'Yan",
            theme: "Minimal Magazine Style",
            tags: ["Astro", "TypeScript", "Engineering"],
            features: {
              trending: true,
              toolbox: true,
              offlineReady: true,
            },
          },
          null,
          2
        );
      });

      document.getElementById("btn-json-format")?.addEventListener("click", () => {
        if (!jsonIn || !jsonOut) return;
        const raw = jsonIn.value.trim();
        if (!raw) {
          showStatus("json-status", "请输入需要格式化的 JSON 内容，或点击「示例」", true);
          return;
        }
        try {
          const parsed = JSON.parse(raw);
          const space = jsonIndent && jsonIndent.value === "tabs" ? "\t" : parseInt(jsonIndent?.value || "2", 10);
          jsonOut.textContent = JSON.stringify(parsed, null, space);
          showStatus("json-status", "格式化成功！");
        } catch (e: any) {
          showStatus("json-status", `JSON 语法解析错误: ${e.message}`, true);
        }
      });

      document.getElementById("btn-json-minify")?.addEventListener("click", () => {
        if (!jsonIn || !jsonOut) return;
        const raw = jsonIn.value.trim();
        if (!raw) {
          showStatus("json-status", "请输入需要压缩的 JSON 内容", true);
          return;
        }
        try {
          const parsed = JSON.parse(raw);
          jsonOut.textContent = JSON.stringify(parsed);
          showStatus("json-status", "单行压缩成功！");
        } catch (e: any) {
          showStatus("json-status", `JSON 语法解析错误: ${e.message}`, true);
        }
      });

      document.getElementById("btn-json-copy")?.addEventListener("click", () => {
        if (jsonOut && jsonOut.textContent) {
          navigator.clipboard.writeText(jsonOut.textContent);
          showStatus("json-status", "已复制格式化结果到剪贴板！");
        }
      });

      document.getElementById("btn-json-clear")?.addEventListener("click", () => {
        if (jsonIn) jsonIn.value = "";
        if (jsonOut) jsonOut.textContent = "";
        showStatus("json-status", "已清空内容");
      });

      // ==========================================
      // 2. Base64 编解码 (UTF-8 安全)
      // ==========================================
      const b64In = document.getElementById("b64-input") as HTMLTextAreaElement | null;
      const b64Out = document.getElementById("b64-output") as HTMLTextAreaElement | null;

      document.getElementById("btn-b64-sample")?.addEventListener("click", () => {
        if (b64In) b64In.value = "你好，世界！Hello World 🚀 专注极简杂志美学设计";
      });

      document.getElementById("btn-b64-encode")?.addEventListener("click", () => {
        if (!b64In || !b64Out) return;
        if (!b64In.value.trim()) {
          showStatus("b64-status", "请输入需要编码的明文，或点击「示例」", true);
          return;
        }
        try {
          const bytes = new TextEncoder().encode(b64In.value);
          const binString = Array.from(bytes, (b) => String.fromCharCode(b)).join("");
          b64Out.value = btoa(binString);
          showStatus("b64-status", "Base64 编码成功！");
        } catch (e: any) {
          showStatus("b64-status", `编码错误: ${e.message}`, true);
        }
      });

      document.getElementById("btn-b64-decode")?.addEventListener("click", () => {
        if (!b64In || !b64Out) return;
        const raw = b64In.value.trim();
        if (!raw) {
          showStatus("b64-status", "请输入需要解码的 Base64 字符串", true);
          return;
        }
        try {
          const binString = atob(raw);
          const bytes = Uint8Array.from(binString, (m) => m.charCodeAt(0));
          b64Out.value = new TextDecoder().decode(bytes);
          showStatus("b64-status", "Base64 解码成功！");
        } catch {
          showStatus("b64-status", "解码失败：输入内容不是合法的 Base64 字符串。", true);
        }
      });

      document.getElementById("btn-b64-copy")?.addEventListener("click", () => {
        if (b64Out && b64Out.value) {
          navigator.clipboard.writeText(b64Out.value);
          showStatus("b64-status", "已复制到剪贴板！");
        }
      });

      document.getElementById("btn-b64-clear")?.addEventListener("click", () => {
        if (b64In) b64In.value = "";
        if (b64Out) b64Out.value = "";
      });

      // ==========================================
      // 3. URL 编解码
      // ==========================================
      const urlIn = document.getElementById("url-input") as HTMLTextAreaElement | null;
      const urlOut = document.getElementById("url-output") as HTMLTextAreaElement | null;

      document.getElementById("btn-url-sample")?.addEventListener("click", () => {
        if (urlIn) urlIn.value = "https://laizeyan.github.io/search?keyword=前端工程&category=tools&sort=asc&date=2026-10";
      });

      document.getElementById("btn-url-encode")?.addEventListener("click", () => {
        if (!urlIn || !urlOut) return;
        if (!urlIn.value.trim()) {
          showStatus("url-status", "请输入需要编码的 URL 或参数文本", true);
          return;
        }
        urlOut.value = encodeURIComponent(urlIn.value);
        showStatus("url-status", "URL 编码完成！");
      });

      document.getElementById("btn-url-decode")?.addEventListener("click", () => {
        if (!urlIn || !urlOut) return;
        if (!urlIn.value.trim()) {
          showStatus("url-status", "请输入需要解码的 URL 或参数文本", true);
          return;
        }
        try {
          urlOut.value = decodeURIComponent(urlIn.value);
          showStatus("url-status", "URL 解码完成！");
        } catch (e: any) {
          showStatus("url-status", `解码失败: ${e.message}`, true);
        }
      });

      document.getElementById("btn-url-copy")?.addEventListener("click", () => {
        if (urlOut && urlOut.value) {
          navigator.clipboard.writeText(urlOut.value);
          showStatus("url-status", "已复制到剪贴板！");
        }
      });

      document.getElementById("btn-url-clear")?.addEventListener("click", () => {
        if (urlIn) urlIn.value = "";
        if (urlOut) urlOut.value = "";
      });

      // ==========================================
      // 4. Unicode 转换
      // ==========================================
      const uniIn = document.getElementById("uni-input") as HTMLTextAreaElement | null;
      const uniOut = document.getElementById("uni-output") as HTMLTextAreaElement | null;

      document.getElementById("btn-uni-sample")?.addEventListener("click", () => {
        if (uniIn) uniIn.value = "优雅永不过时 · Minimal Magazine Design 🚀";
      });

      document.getElementById("btn-uni-to-u")?.addEventListener("click", () => {
        if (!uniIn || !uniOut) return;
        if (!uniIn.value.trim()) {
          showStatus("uni-status", "请输入需要转换的文本内容", true);
          return;
        }
        uniOut.value = uniIn.value
          .split("")
          .map((c) => {
            const code = c.charCodeAt(0);
            return code > 127 ? "\\u" + code.toString(16).padStart(4, "0") : c;
          })
          .join("");
        showStatus("uni-status", "转为 Unicode 编码完成！");
      });

      document.getElementById("btn-u-to-text")?.addEventListener("click", () => {
        if (!uniIn || !uniOut) return;
        if (!uniIn.value.trim()) {
          showStatus("uni-status", "请输入包含 \\uXXXX 的 Unicode 编码文本", true);
          return;
        }
        try {
          uniOut.value = uniIn.value.replace(/\\u([0-9a-fA-F]{4})/g, (_, hex) =>
            String.fromCharCode(parseInt(hex, 16))
          );
          showStatus("uni-status", "解码为明文完成！");
        } catch (e: any) {
          showStatus("uni-status", `转换失败: ${e.message}`, true);
        }
      });

      document.getElementById("btn-uni-copy")?.addEventListener("click", () => {
        if (uniOut && uniOut.value) {
          navigator.clipboard.writeText(uniOut.value);
          showStatus("uni-status", "已复制到剪贴板！");
        }
      });

      document.getElementById("btn-uni-clear")?.addEventListener("click", () => {
        if (uniIn) uniIn.value = "";
        if (uniOut) uniOut.value = "";
      });

      // ==========================================
      // 5. Unix 时间戳与时区时钟
      // ==========================================
      const liveSec = document.getElementById("live-ts-sec");
      const liveMs = document.getElementById("live-ts-ms");
      let clockRunning = true;

      function updateLiveClock() {
        if (!clockRunning) return;
        const now = Date.now();
        if (liveSec) liveSec.textContent = Math.floor(now / 1000).toString();
        if (liveMs) liveMs.textContent = now.toString();
      }
      updateLiveClock();
      clockInterval = setInterval(updateLiveClock, 500);

      const toggleClockBtn = document.getElementById("btn-toggle-clock");
      toggleClockBtn?.addEventListener("click", () => {
        clockRunning = !clockRunning;
        if (toggleClockBtn) {
          toggleClockBtn.textContent = clockRunning ? "暂停时钟" : "恢复时钟";
        }
      });

      // 时间戳 -> 日期
      const tsInput = document.getElementById("ts-to-date-input") as HTMLInputElement | null;
      const convertTsToDate = () => {
        if (!tsInput) return;
        const val = tsInput.value.trim();
        if (!val) return;
        let ts = parseInt(val, 10);
        if (isNaN(ts)) return;
        if (val.length === 10) ts *= 1000;
        const d = new Date(ts);
        if (isNaN(d.getTime())) return;

        const bjEl = document.getElementById("res-bj");
        const utcEl = document.getElementById("res-utc");
        const isoEl = document.getElementById("res-iso");
        if (bjEl) {
          bjEl.textContent = d.toLocaleString("zh-CN", {
            timeZone: "Asia/Shanghai",
            hour12: false,
          });
        }
        if (utcEl) utcEl.textContent = d.toUTCString();
        if (isoEl) isoEl.textContent = d.toISOString();
      };

      document.getElementById("btn-ts-to-date")?.addEventListener("click", convertTsToDate);

      document.getElementById("btn-ts-fill-now")?.addEventListener("click", () => {
        if (tsInput) {
          tsInput.value = Math.floor(Date.now() / 1000).toString();
          convertTsToDate();
        }
      });

      // 日期 -> 时间戳
      const dateInput = document.getElementById("date-to-ts-input") as HTMLInputElement | null;
      const convertDateToTs = () => {
        if (!dateInput || !dateInput.value) return;
        const d = new Date(dateInput.value);
        const ms = d.getTime();
        if (isNaN(ms)) return;
        const secEl = document.getElementById("res-sec");
        const msEl = document.getElementById("res-ms");
        if (secEl) secEl.textContent = Math.floor(ms / 1000).toString();
        if (msEl) msEl.textContent = ms.toString();
      };

      document.getElementById("btn-date-to-ts")?.addEventListener("click", convertDateToTs);

      document.getElementById("btn-date-fill-now")?.addEventListener("click", () => {
        if (dateInput) {
          const now = new Date();
          const pad = (n: number) => n.toString().padStart(2, "0");
          dateInput.value = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
          convertDateToTs();
        }
      });

      // 默认填入初始时间进行转换展示
      if (tsInput && !tsInput.value) {
        tsInput.value = Math.floor(Date.now() / 1000).toString();
        convertTsToDate();
      }
      if (dateInput && !dateInput.value) {
        const now = new Date();
        const pad = (n: number) => n.toString().padStart(2, "0");
        dateInput.value = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}T${pad(now.getHours())}:${pad(now.getMinutes())}:${pad(now.getSeconds())}`;
        convertDateToTs();
      }

      // ==========================================
      // 6. 字数统计与阅读估时
      // ==========================================
      const wcIn = document.getElementById("wc-input") as HTMLTextAreaElement | null;
      function calcWordCount() {
        if (!wcIn) return;
        const str = wcIn.value;
        const totalChars = str.length;
        const nonSpace = str.replace(/\s/g, "").length;
        const cjk = (str.match(/[\u4e00-\u9fa5\u3040-\u30ff\uac00-\ud7af]/g) || []).length;
        const words = (str.match(/[a-zA-Z0-9_-]+/g) || []).length;
        const lines = str ? str.split(/\r\n|\r|\n/).length : 0;
        const estMin = Math.ceil((cjk + words) / 350);

        const tc = document.getElementById("stat-total-chars");
        const ns = document.getElementById("stat-non-space");
        const ck = document.getElementById("stat-cjk");
        const wd = document.getElementById("stat-words");
        const ln = document.getElementById("stat-lines");
        const rt = document.getElementById("stat-reading-time");

        if (tc) tc.textContent = totalChars.toString();
        if (ns) ns.textContent = nonSpace.toString();
        if (ck) ck.textContent = cjk.toString();
        if (wd) wd.textContent = words.toString();
        if (ln) ln.textContent = lines.toString();
        if (rt) rt.textContent = `${estMin} 分钟`;
      }

      wcIn?.addEventListener("input", calcWordCount);

      document.getElementById("btn-wc-sample")?.addEventListener("click", () => {
        if (!wcIn) return;
        wcIn.value = `## 设计的本质是减法\n\n好的设计不仅在于添加了什么，更在于去掉了什么。在这座数字花园中，我们追求像纸质刊物一样的宁静与排版韵味。\n\nEvery line of code and every stroke of design should serve a clear purpose. Zero clutter, pure focus.`;
        calcWordCount();
      });

      document.getElementById("btn-wc-clear")?.addEventListener("click", () => {
        if (wcIn) wcIn.value = "";
        calcWordCount();
      });

      // ==========================================
      // 7. 文本差异对比 (Diff)
      // ==========================================
      const diffOrig = document.getElementById("diff-original") as HTMLTextAreaElement | null;
      const diffMod = document.getElementById("diff-modified") as HTMLTextAreaElement | null;
      const resBox = document.getElementById("diff-result");

      function runDiff() {
        if (!diffOrig || !diffMod || !resBox) return;
        const orig = diffOrig.value.split("\n");
        const mod = diffMod.value.split("\n");

        if (!diffOrig.value && !diffMod.value) {
          resBox.innerHTML = '<p class="diff-placeholder">请输入需要对比的文本或点击「填入对比示例」。</p>';
          return;
        }

        let html = '<div class="diff-lines">';
        const max = Math.max(orig.length, mod.length);
        for (let i = 0; i < max; i++) {
          const l1 = orig[i];
          const l2 = mod[i];
          if (l1 === undefined) {
            html += `<div class="diff-line diff-add"><span class="diff-num">+</span>${escapeHtml(l2)}</div>`;
          } else if (l2 === undefined) {
            html += `<div class="diff-line diff-del"><span class="diff-num">-</span>${escapeHtml(l1)}</div>`;
          } else if (l1 === l2) {
            html += `<div class="diff-line diff-eq"><span class="diff-num"> </span>${escapeHtml(l1)}</div>`;
          } else {
            html += `<div class="diff-line diff-del"><span class="diff-num">-</span>${escapeHtml(l1)}</div>`;
            html += `<div class="diff-line diff-add"><span class="diff-num">+</span>${escapeHtml(l2)}</div>`;
          }
        }
        html += "</div>";
        resBox.innerHTML = html;
      }

      document.getElementById("btn-run-diff")?.addEventListener("click", runDiff);

      document.getElementById("btn-diff-sample")?.addEventListener("click", () => {
        if (!diffOrig || !diffMod) return;
        diffOrig.value = `// 版本 1.0\nconst user = {\n  name: "Ze'Yan",\n  role: "guest",\n  theme: "light"\n};`;
        diffMod.value = `// 版本 2.0\nconst user = {\n  name: "Ze'Yan",\n  role: "admin",\n  theme: "dark",\n  verified: true\n};`;
        runDiff();
      });

      document.getElementById("btn-diff-clear")?.addEventListener("click", () => {
        if (diffOrig) diffOrig.value = "";
        if (diffMod) diffMod.value = "";
        if (resBox) resBox.innerHTML = '<p class="diff-placeholder">点击「比较差异」开始对比左右两段文本。</p>';
      });

      // ==========================================
      // 8. 正则表达式测试
      // ==========================================
      const regPattern = document.getElementById("regex-pattern") as HTMLInputElement | null;
      const regFlags = document.getElementById("regex-flags") as HTMLInputElement | null;
      const regText = document.getElementById("regex-text") as HTMLTextAreaElement | null;
      const regBox = document.getElementById("regex-matches-box");

      function runRegex() {
        if (!regPattern || !regFlags || !regText || !regBox) return;
        const pattern = regPattern.value;
        const flags = regFlags.value;
        const text = regText.value;

        if (!pattern || !text) {
          regBox.innerHTML = '<p class="text-muted">请输入正则表达式和测试文本...</p>';
          return;
        }

        try {
          const reg = new RegExp(pattern, flags);
          let matches: Array<{ match: string; index: number; groups: string[] }> = [];
          if (flags.includes("g")) {
            let m: RegExpExecArray | null;
            let guard = 0;
            while ((m = reg.exec(text)) !== null && guard < 1000) {
              matches.push({ match: m[0], index: m.index, groups: m.slice(1) });
              if (reg.lastIndex === m.index) reg.lastIndex++;
              guard++;
            }
          } else {
            const m = reg.exec(text);
            if (m) matches.push({ match: m[0], index: m.index, groups: m.slice(1) });
          }

          if (matches.length === 0) {
            regBox.innerHTML = '<p class="status-msg status-err">未匹配到任何结果。</p>';
            return;
          }

          let outHtml = `<div class="match-summary">匹配到 <strong>${matches.length}</strong> 处结果:</div>`;
          matches.forEach((item, idx) => {
            outHtml += `
              <div class="match-card">
                <span class="match-idx">#${idx + 1}</span>
                <span class="match-str">${escapeHtml(item.match)}</span>
                ${item.groups.length ? `<span class="match-groups">捕获组: [${item.groups.map((g) => `"${escapeHtml(g)}"`).join(", ")}]</span>` : ""}
              </div>
            `;
          });
          regBox.innerHTML = outHtml;
        } catch (e: any) {
          regBox.innerHTML = `<p class="status-msg status-err">正则表达式语法错误: ${escapeHtml(e.message)}</p>`;
        }
      }

      regPattern?.addEventListener("input", runRegex);
      regFlags?.addEventListener("input", runRegex);
      regText?.addEventListener("input", runRegex);

      document.querySelectorAll(".preset-btn").forEach((btn) => {
        btn.addEventListener("click", () => {
          if (!regPattern || !regFlags || !regText) return;
          regPattern.value = btn.getAttribute("data-reg") || "";
          regFlags.value = btn.getAttribute("data-flags") || "g";
          const sample = btn.getAttribute("data-sample");
          if (sample) regText.value = sample;
          runRegex();
        });
      });

      // 默认执行一次预填充正则
      if (regPattern && regPattern.value && regText && regText.value) {
        runRegex();
      }

      // ==========================================
      // 9. GitHub 像素头像生成器 (Identicon)
      // ==========================================
      const avInput = document.getElementById("avatar-input") as HTMLInputElement | null;
      const canvas = document.getElementById("avatar-canvas") as HTMLCanvasElement | null;

      function hashString(str: string) {
        let hash = 0;
        for (let i = 0; i < str.length; i++) {
          hash = (hash << 5) - hash + str.charCodeAt(i);
          hash |= 0;
        }
        return Math.abs(hash);
      }

      function renderAvatar() {
        if (!canvas || !avInput) return;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;
        const val = avInput.value.trim() || "guest";
        const hash = hashString(val);

        const hue = hash % 360;
        const fgColor = `hsl(${hue}, 65%, 45%)`;
        const bgColor = "#f7f5ed";

        ctx.fillStyle = bgColor;
        ctx.fillRect(0, 0, canvas.width, canvas.height);

        const gridSize = 5;
        const cellSize = canvas.width / (gridSize + 2);
        ctx.fillStyle = fgColor;

        for (let r = 0; r < gridSize; r++) {
          for (let c = 0; c < Math.ceil(gridSize / 2); c++) {
            const bit = (hash >> (r * 3 + c)) & 1;
            if (bit === 1) {
              const x1 = (c + 1) * cellSize;
              const x2 = (gridSize - c) * cellSize;
              const y = (r + 1) * cellSize;
              ctx.fillRect(x1, y, cellSize, cellSize);
              ctx.fillRect(x2, y, cellSize, cellSize);
            }
          }
        }
      }

      avInput?.addEventListener("input", renderAvatar);

      document.getElementById("btn-avatar-random")?.addEventListener("click", () => {
        if (!avInput) return;
        avInput.value = "user-" + Math.random().toString(36).substring(2, 8);
        renderAvatar();
      });

      document.getElementById("btn-avatar-download")?.addEventListener("click", () => {
        if (!canvas || !avInput) return;
        const link = document.createElement("a");
        link.download = `avatar-${avInput.value || "identicon"}.png`;
        link.href = canvas.toDataURL("image/png");
        link.click();
      });

      renderAvatar();
    }

    // 绑定 Astro 页面加载与路由切换事件
    document.addEventListener("astro:page-load", initToolbox);
  </script>
</Base>

