      function b64UrlDecode(str: string): string {
        let output = str.replace(/-/g, "+").replace(/_/g, "/");
        switch (output.length % 4) {
          case 0: break;
          case 2: output += "=="; break;
          case 3: output += "="; break;
          default: throw new Error("非法 Base64URL 格式");
        }
        const bin = atob(output);
        const bytes = Uint8Array.from(bin, (m) => m.charCodeAt(0));
        return new TextDecoder().decode(bytes);
      }

      function parseJwt() {
        if (!jwtIn || !jwtHeaderOut || !jwtPayloadOut) return;
        const token = jwtIn.value.trim();
        if (!token) {
          showStatus("jwt-status", "请输入 JWT 令牌内容，或点击「示例」", true);
          return;
        }

        const parts = token.split(".");
        if (parts.length < 2) {
          showStatus("jwt-status", "无效的 JWT 令牌格式（必须包含 Header 与 Payload）", true);
          return;
        }

        try {
          const headerStr = b64UrlDecode(parts[0]);
          const payloadStr = b64UrlDecode(parts[1]);

          const headerObj = JSON.parse(headerStr);
          const payloadObj = JSON.parse(payloadStr);

          jwtHeaderOut.textContent = JSON.stringify(headerObj, null, 2);
          jwtPayloadOut.textContent = JSON.stringify(payloadObj, null, 2);

          if (jwtInfoCard) jwtInfoCard.style.display = "block";
          if (jwtAlg) jwtAlg.textContent = headerObj.alg || "none";
          if (jwtTyp) jwtTyp.textContent = headerObj.typ || "JWT";

          // 过期与签发时间解析
          const nowSec = Math.floor(Date.now() / 1000);
          if (payloadObj.exp && typeof payloadObj.exp === "number") {
            const expDate = new Date(payloadObj.exp * 1000);
            const isExpired = payloadObj.exp < nowSec;
            const diffSec = Math.abs(payloadObj.exp - nowSec);
            const days = Math.floor(diffSec / 86400);
            const hours = Math.floor((diffSec % 86400) / 3600);
            const diffDesc = days > 0 ? `${days}天${hours}小时` : `${hours}小时`;

            if (jwtExp) {
              jwtExp.textContent = `${expDate.toLocaleString("zh-CN")} (${isExpired ? "已过期 " + diffDesc : "剩余 " + diffDesc})`;
            }
            if (jwtStatusPill) {
              jwtStatusPill.textContent = isExpired ? "已过期" : "有效 (未过期)";
              jwtStatusPill.className = `jwt-status-pill ${isExpired ? "jwt-pill-expired" : "jwt-pill-valid"}`;
            }
          } else {
            if (jwtExp) jwtExp.textContent = "未设置 (永久有效)";
            if (jwtStatusPill) {
              jwtStatusPill.textContent = "无过期时间";
              jwtStatusPill.className = "jwt-status-pill jwt-pill-perm";
            }
          }

          if (payloadObj.iat && typeof payloadObj.iat === "number") {
            const iatDate = new Date(payloadObj.iat * 1000);
            if (jwtIat) jwtIat.textContent = iatDate.toLocaleString("zh-CN");
          } else {
            if (jwtIat) jwtIat.textContent = "未设置";
          }

          showStatus("jwt-status", "JWT 令牌解析成功！");
        } catch (e: any) {
          showStatus("jwt-status", `JWT 解析错误: ${e.message}`, true);
        }
      }

      document.getElementById("btn-jwt-parse")?.addEventListener("click", parseJwt);

