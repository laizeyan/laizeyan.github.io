---
// src/pages/tools.astro
import Base from "../layouts/Base.astro";

const toolCategories = [
  {
    name: "数据转换",
    tools: [
      { id: "json", name: "JSON 格式化", icon: "{ }" },
      { id: "base64", name: "Base64 编解码", icon: "64" },
      { id: "url", name: "URL 编解码", icon: "%" },
      { id: "unicode", name: "Unicode 转换", icon: "U+" },
      { id: "jwt", name: "JWT 令牌解析", icon: "🔑" },
    ],
  },
  {
    name: "编码加密",
    tools: [
      { id: "hash", name: "哈希散列计算", icon: "#" },
      { id: "uuid", name: "UUID与强密码", icon: "🎲" },
    ],
  },
  {
    name: "时间与时区",
    tools: [
      { id: "timestamp", name: "时间戳转换", icon: "⏱" },
    ],
  },
  {
    name: "文本分析",
    tools: [
      { id: "wordcount", name: "字数与阅读统计", icon: "Aa" },
      { id: "diff", name: "文本差异对比", icon: "±" },
      { id: "regex", name: "正则表达式测试", icon: ".*" },
    ],
  },
  {
    name: "设计开发",
    tools: [
      { id: "color", name: "颜色转换与色板", icon: "🎨" },
      { id: "avatar", name: "GitHub 像素头像", icon: "👾" },
    ],
  },
];
---

<Base
  title="实用工具箱 · Ze'Yan"
  description="开箱即用的前端开发工具箱：JSON格式化、Base64/URL转换、JWT解析、哈希计算、UUID生成、时间戳、正则测试等"
>
  <article class="tools-page reveal">
    <header class="tools-head">
      <div class="tools-head-accent" aria-hidden="true"></div>
      <p class="section-kicker">开发者利器</p>
      <h1>实用工具</h1>
      <p class="lead">
        轻量高效的纯前端开发工具套件，数据全在本地浏览器完成处理，零泄露风险。
      </p>
    </header>

    <hr class="rule" />

    <!-- 工具箱交互框架 -->
    <div class="toolbox-layout">
      <!-- 侧边 / 顶部工具快捷切换菜单 -->
      <aside class="toolbox-sidebar" aria-label="工具列表">
        <div class="sidebar-search-box">
          <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
          <input
            type="text"
            id="tool-search-input"
            class="sidebar-search-input"
            placeholder="搜索工具 (快捷键 /)..."
            aria-label="快速检索工具"
          />
        </div>
        <div class="sidebar-cats-wrapper" id="sidebar-cats-wrapper">
          {
            toolCategories.map((cat) => (
              <div class="tool-cat-group">
                <span class="cat-title">{cat.name}</span>
                <nav class="tool-nav">
                  {cat.tools.map((t) => (
                    <button
                      class="tool-btn"
                      data-tool-target={t.id}
                      data-tool-name={t.name.toLowerCase()}
                      data-tool-cat={cat.name.toLowerCase()}
                      id={`btn-${t.id}`}
                      aria-label={t.name}
                    >
                      <span class="tool-icon" aria-hidden="true">{t.icon}</span>
                      <span class="tool-name">{t.name}</span>
                    </button>
                  ))}
                </nav>
              </div>
            ))
          }
        </div>
      </aside>

      <!-- 工具主操作区 -->
      <div class="toolbox-panel" id="toolbox-active-panel" role="region" aria-label="工具操作区">
        <!-- 1. JSON 格式化工具 -->
        <section class="tool-section" id="section-json">
          <div class="tool-header">
            <h2>JSON 格式化、压缩与转义</h2>
            <div class="tool-actions">
              <label class="action-label">
                缩进
                <select id="json-indent" class="select-sm">
                  <option value="2">2 空格</option>
                  <option value="4">4 空格</option>
                  <option value="tabs">Tab</option>
                </select>
              </label>
              <button class="btn btn-sm btn-primary" id="btn-json-format">格式化</button>
              <button class="btn btn-sm btn-secondary" id="btn-json-minify">压缩单行</button>
              <button class="btn btn-sm btn-secondary" id="btn-json-escape">转义单行</button>
              <button class="btn btn-sm btn-secondary" id="btn-json-unescape">去除转义</button>
              <button class="btn btn-sm btn-secondary" id="btn-json-copy">复制结果</button>
              <label class="btn btn-sm btn-outline file-btn-label">
                导入文件
                <input type="file" id="json-file-input" accept=".json,.txt,.log" style="display:none;" />
              </label>
              <button class="btn btn-sm btn-outline" id="btn-json-sample">示例</button>
              <button class="btn btn-sm btn-outline" id="btn-json-clear">清空</button>
              <button type="button" class="btn btn-sm btn-outline btn-layout-toggle" title="切换左右并排或上下堆叠">并排 ⇄ 堆叠</button>
            </div>
          </div>
          <div class="editor-grid">
            <div class="editor-col">
              <div class="pane-header">
                <span class="pane-tag">INPUT</span>
                <span class="col-kicker">输入 JSON 数据</span>
                <span class="pane-stats" id="json-input-stats"></span>
              </div>
              <textarea id="json-input" class="code-area" placeholder="在此粘贴或输入 JSON 数据，或拖拽文件到此处..."></textarea>
            </div>
            <div class="editor-col">
              <div class="pane-header">
                <span class="pane-tag pane-tag-out">OUTPUT</span>
                <span class="col-kicker">处理结果</span>
                <span class="pane-stats" id="json-output-stats"></span>
              </div>
              <pre id="json-output" class="code-area code-result"></pre>
            </div>
          </div>
          <p id="json-status" class="status-msg"></p>
        </section>

        <!-- 2. Base64 编解码 -->
        <section class="tool-section" id="section-base64" style="display: none;">
          <div class="tool-header">
            <h2>Base64 编解码 (支持 UTF-8)</h2>
            <div class="tool-actions">
              <button class="btn btn-sm btn-primary" id="btn-b64-encode">文本 ➔ Base64</button>
              <button class="btn btn-sm btn-primary" id="btn-b64-decode">Base64 ➔ 文本</button>
              <button class="btn btn-sm btn-secondary" id="btn-b64-copy">复制结果</button>
              <label class="btn btn-sm btn-outline file-btn-label">
                导入文件转 Base64
                <input type="file" id="b64-file-input" style="display:none;" />
              </label>
              <button class="btn btn-sm btn-outline" id="btn-b64-sample">示例</button>
              <button class="btn btn-sm btn-outline" id="btn-b64-clear">清空</button>
              <button type="button" class="btn btn-sm btn-outline btn-layout-toggle" title="切换左右并排或上下堆叠">并排 ⇄ 堆叠</button>
            </div>
          </div>
          <div class="editor-grid">
            <div class="editor-col">
              <div class="pane-header">
                <span class="pane-tag">INPUT</span>
                <span class="col-kicker">原始输入</span>
                <span class="pane-stats" id="b64-input-stats"></span>
              </div>
              <textarea id="b64-input" class="code-area" placeholder="输入要编码的明文，或要解码的 Base64 字符串..."></textarea>
            </div>
            <div class="editor-col">
              <div class="pane-header">
                <span class="pane-tag pane-tag-out">OUTPUT</span>
                <span class="col-kicker">转换输出</span>
                <span class="pane-stats" id="b64-output-stats"></span>
              </div>
              <textarea id="b64-output" class="code-area" readonly placeholder="处理结果将在此显示..."></textarea>
            </div>
          </div>
          <p id="b64-status" class="status-msg"></p>
        </section>

        <!-- 3. URL 编解码 -->
        <section class="tool-section" id="section-url" style="display: none;">
          <div class="tool-header">
            <h2>URL 编解码与 Query 参数解析</h2>
            <div class="tool-actions">
              <button class="btn btn-sm btn-primary" id="btn-url-encode">URL 编码</button>
              <button class="btn btn-sm btn-primary" id="btn-url-decode">URL 解码</button>
              <button class="btn btn-sm btn-secondary" id="btn-url-parse-params">解析 Query 为 JSON</button>
              <button class="btn btn-sm btn-secondary" id="btn-url-copy">复制结果</button>
              <button class="btn btn-sm btn-outline" id="btn-url-sample">示例</button>
              <button class="btn btn-sm btn-outline" id="btn-url-clear">清空</button>
              <button type="button" class="btn btn-sm btn-outline btn-layout-toggle" title="切换左右并排或上下堆叠">并排 ⇄ 堆叠</button>
            </div>
          </div>
          <div class="editor-grid">
            <div class="editor-col">
              <div class="pane-header">
                <span class="pane-tag">INPUT</span>
                <span class="col-kicker">待处理 URL / 参数文本</span>
                <span class="pane-stats" id="url-input-stats"></span>
              </div>
              <textarea id="url-input" class="code-area" placeholder="输入 URL 或 query 字符串..."></textarea>
            </div>
            <div class="editor-col">
              <div class="pane-header">
                <span class="pane-tag pane-tag-out">OUTPUT</span>
                <span class="col-kicker">转换结果</span>
                <span class="pane-stats" id="url-output-stats"></span>
              </div>
              <textarea id="url-output" class="code-area" readonly placeholder="输出结果..."></textarea>
            </div>
          </div>
          <p id="url-status" class="status-msg"></p>
        </section>

        <!-- 4. Unicode 转换 -->
        <section class="tool-section" id="section-unicode" style="display: none;">
          <div class="tool-header">
            <h2>Unicode 互转 (\\uXXXX)</h2>
            <div class="tool-actions">
              <button class="btn btn-sm btn-primary" id="btn-uni-to-u">文本 ➔ Unicode</button>
              <button class="btn btn-sm btn-primary" id="btn-u-to-text">Unicode ➔ 文本</button>
              <button class="btn btn-sm btn-secondary" id="btn-uni-copy">复制结果</button>
              <button class="btn btn-sm btn-outline" id="btn-uni-sample">示例</button>
              <button class="btn btn-sm btn-outline" id="btn-uni-clear">清空</button>
              <button type="button" class="btn btn-sm btn-outline btn-layout-toggle" title="切换左右并排或上下堆叠">并排 ⇄ 堆叠</button>
            </div>
          </div>
          <div class="editor-grid">
            <div class="editor-col">
              <div class="pane-header">
                <span class="pane-tag">INPUT</span>
                <span class="col-kicker">输入文本 / 编码</span>
                <span class="pane-stats" id="uni-input-stats"></span>
              </div>
              <textarea id="uni-input" class="code-area" placeholder="输入中文或 \\u4e2d\\u6587..."></textarea>
            </div>
            <div class="editor-col">
              <div class="pane-header">
                <span class="pane-tag pane-tag-out">OUTPUT</span>
                <span class="col-kicker">转换结果</span>
                <span class="pane-stats" id="uni-output-stats"></span>
              </div>
              <textarea id="uni-output" class="code-area" readonly placeholder="输出结果..."></textarea>
            </div>
          </div>
          <p id="uni-status" class="status-msg"></p>
        </section>

        <!-- 5. JWT 令牌解析 -->
        <section class="tool-section" id="section-jwt" style="display: none;">
          <div class="tool-header">
            <h2>JWT 令牌解析与校验</h2>
            <div class="tool-actions">
              <button class="btn btn-sm btn-primary" id="btn-jwt-parse">解析令牌</button>
              <button class="btn btn-sm btn-secondary" id="btn-jwt-copy-payload">复制 Payload</button>
              <button class="btn btn-sm btn-outline" id="btn-jwt-sample">示例</button>
              <button class="btn btn-sm btn-outline" id="btn-jwt-clear">清空</button>
            </div>
          </div>
          <div class="editor-col" style="margin-bottom: 16px;">
            <div class="pane-header">
              <span class="pane-tag">TOKEN</span>
              <span class="col-kicker">粘贴 JSON Web Token (Header.Payload.Signature)</span>
              <span class="pane-stats" id="jwt-input-stats"></span>
            </div>
            <textarea id="jwt-input" class="code-area jwt-input-area" placeholder="在此粘贴以 eyJ 开头的 JWT 字符串..."></textarea>
          </div>
          
          <div class="jwt-token-info-card" id="jwt-info-card" style="display: none;">
            <div class="jwt-meta-badges">
              <span class="jwt-status-pill" id="jwt-status-pill">--</span>
              <span class="jwt-meta-item">算法: <strong id="jwt-alg">--</strong></span>
              <span class="jwt-meta-item">类型: <strong id="jwt-typ">--</strong></span>
              <span class="jwt-meta-item">过期时间: <strong id="jwt-exp">--</strong></span>
              <span class="jwt-meta-item">签发时间: <strong id="jwt-iat">--</strong></span>
            </div>
          </div>

          <div class="editor-grid">
            <div class="editor-col">
              <div class="pane-header">
                <span class="pane-tag">HEADER</span>
                <span class="col-kicker">标头数据 (Algorithm & Type)</span>
              </div>
              <pre id="jwt-header-out" class="code-area code-result"></pre>
            </div>
            <div class="editor-col">
              <div class="pane-header">
                <span class="pane-tag pane-tag-out">PAYLOAD</span>
                <span class="col-kicker">有效载荷 (Claims & Data)</span>
              </div>
              <pre id="jwt-payload-out" class="code-area code-result"></pre>
            </div>
          </div>
          <p id="jwt-status" class="status-msg"></p>
        </section>

        <!-- 6. 哈希散列计算 -->
        <section class="tool-section" id="section-hash" style="display: none;">
          <div class="tool-header">
            <h2>哈希散列计算 (MD5 / SHA 系列)</h2>
            <div class="tool-actions">
              <label class="action-label">
                <input type="checkbox" id="hash-uppercase" /> 大写散列
              </label>
              <button class="btn btn-sm btn-secondary" id="btn-hash-sample">填入示例</button>
              <button class="btn btn-sm btn-outline" id="btn-hash-clear">清空</button>
            </div>
          </div>

          <div class="editor-col" style="margin-bottom: 18px;">
            <div class="pane-header">
              <span class="pane-tag">INPUT</span>
              <span class="col-kicker">待计算文本字符串</span>
              <span class="pane-stats" id="hash-input-stats"></span>
            </div>
            <textarea id="hash-input" class="code-area hash-input-area" placeholder="在此输入需要计算哈希的明文内容..."></textarea>
          </div>

          <div class="hash-compare-bar">
            <span class="hash-compare-label">哈希比对校验:</span>
            <input type="text" id="hash-compare-input" class="input-text" placeholder="粘贴已知哈希值，自动校验是否匹配..." />
            <span id="hash-compare-result" class="hash-match-pill"></span>
          </div>

          <div class="hash-results-list">
            <div class="hash-row" id="row-md5">
              <span class="hash-algo">MD5</span>
              <span class="hash-value" id="val-md5">--</span>
              <button class="btn btn-sm btn-outline btn-copy-hash" data-target="val-md5">复制</button>
            </div>
            <div class="hash-row" id="row-sha1">
              <span class="hash-algo">SHA-1</span>
              <span class="hash-value" id="val-sha1">--</span>
              <button class="btn btn-sm btn-outline btn-copy-hash" data-target="val-sha1">复制</button>
            </div>
            <div class="hash-row" id="row-sha256">
              <span class="hash-algo">SHA-256</span>
              <span class="hash-value" id="val-sha256">--</span>
              <button class="btn btn-sm btn-outline btn-copy-hash" data-target="val-sha256">复制</button>
            </div>
            <div class="hash-row" id="row-sha512">
              <span class="hash-algo">SHA-512</span>
              <span class="hash-value" id="val-sha512">--</span>
              <button class="btn btn-sm btn-outline btn-copy-hash" data-target="val-sha512">复制</button>
            </div>
          </div>
          <p id="hash-status" class="status-msg"></p>
        </section>

        <!-- 7. UUID 与强密码生成 -->
        <section class="tool-section" id="section-uuid" style="display: none;">
          <div class="tool-header">
            <h2>UUID 与安全随机密码生成器</h2>
          </div>

          <div class="gen-dual-grid">
            <!-- 卡片 1: UUID v4 -->
            <div class="gen-card">
              <h3>UUID v4 批量生成</h3>
              <div class="gen-options">
                <label class="action-label">
                  数量
                  <select id="uuid-count" class="select-sm">
                    <option value="1">1 条</option>
                    <option value="5" selected>5 条</option>
                    <option value="10">10 条</option>
                    <option value="20">20 条</option>
                  </select>
                </label>
                <label class="action-label">
                  <input type="checkbox" id="uuid-upper" /> 大写
                </label>
                <label class="action-label">
                  <input type="checkbox" id="uuid-nohyphen" /> 无连字符
                </label>
              </div>
              <div class="gen-actions-row">
                <button class="btn btn-sm btn-primary" id="btn-gen-uuid">生成 UUID</button>
                <button class="btn btn-sm btn-secondary" id="btn-copy-uuid">复制全部</button>
              </div>
              <textarea id="uuid-output" class="code-area gen-output-area" readonly placeholder="点击上方按钮生成 UUID..."></textarea>
            </div>

            <!-- 卡片 2: 安全随机密码 -->
            <div class="gen-card">
              <h3>安全随机密码生成</h3>
              <div class="gen-slider-row">
                <span class="action-label">密码长度: <strong id="pwd-len-val">16</strong> 位</span>
                <input type="range" id="pwd-len" min="8" max="64" value="16" class="range-slider" />
              </div>
              <div class="gen-checkbox-group">
                <label class="action-label"><input type="checkbox" id="pwd-upper" checked /> 大写 (A-Z)</label>
                <label class="action-label"><input type="checkbox" id="pwd-lower" checked /> 小写 (a-z)</label>
                <label class="action-label"><input type="checkbox" id="pwd-digits" checked /> 数字 (0-9)</label>
                <label class="action-label"><input type="checkbox" id="pwd-symbols" checked /> 符号 (!@#$)</label>
                <label class="action-label"><input type="checkbox" id="pwd-no-ambig" /> 排除易混淆</label>
              </div>
              <div class="gen-actions-row">
                <button class="btn btn-sm btn-primary" id="btn-gen-pwd">生成密码</button>
                <button class="btn btn-sm btn-secondary" id="btn-copy-pwd">复制密码</button>
              </div>
              <input type="text" id="pwd-single-output" class="input-text pwd-result-input" readonly placeholder="点击生成随机安全密码..." />
              <div class="pwd-strength-bar-wrap">
                <span class="strength-label">密码强度:</span>
                <div class="strength-meter"><div id="strength-fill" class="strength-fill"></div></div>
                <span id="strength-text" class="strength-text">--</span>
              </div>
            </div>
          </div>
          <p id="uuid-status" class="status-msg"></p>
        </section>

        <!-- 8. 时间戳与时区时钟 -->
        <section class="tool-section" id="section-timestamp" style="display: none;">
          <div class="tool-header">
            <h2>时间戳转换与世界时钟</h2>
          </div>

          <!-- 当前时间戳看板 -->
          <div class="timestamp-live-box">
            <div class="live-clock-section">
              <div class="clock-display">
                <span class="clock-label">当前 Unix 时间戳 (秒)</span>
                <div class="clock-val-row">
                  <span class="clock-val" id="live-ts-sec">--</span>
                  <button type="button" class="btn-copy-chip" data-copy="live-ts-sec" title="复制秒级时间戳">复制</button>
                </div>
              </div>
              <div class="clock-display">
                <span class="clock-label">毫秒时间戳 (ms)</span>
                <div class="clock-val-row">
                  <span class="clock-val" id="live-ts-ms">--</span>
                  <button type="button" class="btn-copy-chip" data-copy="live-ts-ms" title="复制毫秒时间戳">复制</button>
                </div>
              </div>
            </div>
            <div class="clock-actions">
              <button class="btn btn-sm btn-outline" id="btn-toggle-clock">暂停时钟</button>
            </div>
          </div>

          <div class="time-convert-grid">
            <div class="time-card">
              <h3>时间戳 ➔ 北京时间 / ISO</h3>
              <div class="time-input-group">
                <input type="text" id="ts-to-date-input" class="input-text time-input-field" placeholder="输入时间戳 (秒或毫秒)" />
                <div class="time-btn-row">
                  <button class="btn btn-sm btn-primary" id="btn-ts-to-date">转换为日期</button>
                  <button class="btn btn-sm btn-secondary" id="btn-ts-fill-now">填入当前时间戳</button>
                </div>
              </div>
              <div class="time-quick-wrap">
                <span class="time-quick-label">快速偏移:</span>
                <div class="time-quick-btns">
                  <button class="btn-time-quick" data-offset="midnight">今日零点</button>
                  <button class="btn-time-quick" data-offset="+1h">+1小时</button>
                  <button class="btn-time-quick" data-offset="+1d">+1天</button>
                  <button class="btn-time-quick" data-offset="+7d">+7天</button>
                  <button class="btn-time-quick" data-offset="-1d">-1天</button>
                </div>
              </div>
              <div class="time-res-list" id="ts-to-date-res">
                <div class="res-item">
                  <span class="res-lbl">北京时间 (CST):</span>
                  <div class="res-val-box">
                    <strong id="res-bj">--</strong>
                    <button type="button" class="btn-copy-chip" data-copy="res-bj" title="复制北京时间">复制</button>
                  </div>
                </div>
                <div class="res-item">
                  <span class="res-lbl">UTC 时间 (GMT):</span>
                  <div class="res-val-box">
                    <strong id="res-utc">--</strong>
