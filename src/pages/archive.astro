---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 按年份分组
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = Array.from(byYear.keys()).sort((a, b) => b - a);

const formatDate = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    month: "2-digit",
    day: "2-digit",
  });
---

<Base title="归档 · Ze'Yan" description="全部文章按年份归档">
  <header class="page-head reveal">
    <p class="section-kicker">归档</p>
    <h1>文章归档</h1>
    <p class="lead page-lead">
      共 {posts.length} 篇，按年份排印。
    </p>
  </header>

  <hr class="rule" />

  {
    years.map((year, yi) => (
      <section class="archive-year reveal">
        <h2 class="archive-year-title">
          <span class="year-num">{year}</span>
          <span class="year-count">{byYear.get(year)!.length} 篇</span>
        </h2>
        <ol class="archive-list">
          {byYear.get(year)!.map((post, i) => (
            <li class="archive-item">
              <span class="archive-idx" aria-hidden="true">{String(yi * 10 + i + 1).padStart(2, "0")}</span>
              <time class="archive-date">{formatDate(post.data.pubDate)}</time>
              <a class="archive-title" href={`/blog/${post.id}`}>
                {post.data.title}
              </a>
              <div class="archive-tags">
                {post.data.tags.map((tag) => (
                  <a class="tag" href={`/tags/${tag}`}>{tag}</a>
                ))}
              </div>
            </li>
          ))}
        </ol>
      </section>
    ))
  }
</Base>

<style>
  .archive-year {
    margin-top: 44px;
  }

  .archive-year-title {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 0 0 8px;
    padding-bottom: 10px;
    border-bottom: 2px solid var(--text);
    position: relative;
  }

  .year-num {
    font-family: var(--serif);
    font-size: 2.8rem;
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--accent);
    line-height: 1;
  }

  .year-count {
    font-family: var(--sans);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-left: 1px solid var(--border);
    padding-left: 10px;
  }

  .archive-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .archive-item {
    display: grid;
    grid-template-columns: 28px 90px 1fr auto;
    gap: 12px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    position: relative;
  }

  .archive-idx {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--border);
    letter-spacing: -0.02em;
    user-select: none;
  }

  .archive-date {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .archive-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--text);
    text-decoration: none;
    transition: color var(--t-base) ease;
  }

  .archive-title:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .archive-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
  }

  .archive-tags .tag {
    text-decoration: none;
  }

  .archive-tags .tag:hover {
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .archive-item {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .archive-idx {
      display: none;
    }

    .archive-tags {
      justify-content: flex-start;
    }
  }
</style>
