---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 按年份分组
const byYear = new Map<number, typeof posts>();
for (const post of posts) {
  const year = post.data.pubDate.getFullYear();
  if (!byYear.has(year)) byYear.set(year, []);
  byYear.get(year)!.push(post);
}
const years = Array.from(byYear.keys()).sort((a, b) => b - a);

const formatDate = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    month: "2-digit",
    day: "2-digit",
  });
---

<Base title="归档 · Ze'Yan" description="全部文章按年份归档">
  <header class="page-head reveal">
    <p class="section-kicker">归档</p>
    <h1>文章归档</h1>
    <p class="lead page-lead">
      共 {posts.length} 篇，按年份排印。
    </p>
  </header>

  <hr class="rule" />

  {
    years.map((year) => (
      <section class="archive-year reveal">
        <h2 class="archive-year-title">
          <span class="year-num">{year}</span>
          <span class="year-count">{byYear.get(year)!.length} 篇</span>
        </h2>
        <ol class="archive-list">
          {
            byYear.get(year)!.map((post) => (
              <li class="archive-item">
                <time class="archive-date">{formatDate(post.data.pubDate)}</time>
                <a class="archive-title" href={`/blog/${post.id}`}>
                  {post.data.title}
                </a>
                <div class="archive-tags">
                  {post.data.tags.map((tag) => (
                    <a class="tag" href={`/tags/${tag}`}>{tag}</a>
                  ))}
                </div>
              </li>
            ))
          }
        </ol>
      </section>
    ))
  }
</Base>

<style>
  .page-head {
    padding: 40px 0 20px;
  }

  .page-head h1 {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 7vw, 4rem);
    margin: 6px 0 12px;
    letter-spacing: -0.02em;
  }

  .page-lead {
    margin: 0;
    max-width: 560px;
  }

  .archive-year {
    margin-top: 36px;
  }

  .archive-year-title {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 0 0 8px;
    padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
  }

  .year-num {
    font-family: var(--serif);
    font-size: 2.2rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--accent);
  }

  .year-count {
    font-family: var(--sans);
    font-size: 0.82rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .archive-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .archive-item {
    display: grid;
    grid-template-columns: 90px 1fr auto;
    gap: 20px;
    align-items: baseline;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
  }

  .archive-item:last-child {
    border-bottom: none;
  }

  .archive-date {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .archive-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.2rem;
    color: var(--text);
    text-decoration: none;
  }

  .archive-title:hover {
    color: var(--accent);
  }

  .archive-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
  }

  .archive-tags .tag {
    text-decoration: none;
  }

  .archive-tags .tag:hover {
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .archive-item {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .archive-tags {
      justify-content: flex-start;
    }
  }
</style>
