---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const featuredProjects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const formatDate = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
---

<Base
  title="Ze'Yan · 个人站点"
  description="Ze'Yan · AI 驱动的全栈工程师，关注智能体工作流、Linux 与 Web 开发"
>
  <section class="cover reveal" style="--reveal-delay: 0ms">
    <p class="cover-kicker">个人站点 · PORTFOLIO & WRITING</p>
    <h1 class="cover-title">Ze'Yan</h1>
    <p class="lead cover-lead">
      AI 驱动的全栈工程师。这里汇集我的项目、文章与一些慢思考——像一本持续排印的杂志。
    </p>
  </section>

  <hr class="rule" />

  <section class="section reveal" style="--reveal-delay: 80ms">
    <div class="section-head">
      <div>
        <p class="section-kicker">精选项目</p>
        <h2>近期在做</h2>
      </div>
      <a href="/projects" class="more">查看全部 →</a>
    </div>

    <div class="feature-grid">
      {
        featuredProjects.map((project, i) => (
          <a
            class:list={["feature-card", "card", { wide: i % 3 === 0 }]}
            href={`/projects/${project.data.slug ?? project.id}`}
          >
            <span class="feature-letter" aria-hidden="true">
              {project.data.title.charAt(0)}
            </span>
            <div class="feature-body">
              <h3>{project.data.title}</h3>
              <p>{project.data.description}</p>
              <div class="tags">
                {project.data.tags.map((tag) => (
                  <a class="tag" href={`/tags/${tag}`}>{tag}</a>
                ))}
              </div>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <section class="section reveal" style="--reveal-delay: 160ms">
    <div class="section-head">
      <div>
        <p class="section-kicker">最新文章</p>
        <h2>本期目录</h2>
      </div>
      <a href="/blog" class="more">查看全部 →</a>
    </div>

    <ol class="toc">
      {
        latestPosts.map((post) => (
          <li class="toc-item">
            <time class="toc-date">{formatDate(post.data.pubDate)}</time>
            <div class="toc-main">
              <a class="toc-title" href={`/blog/${post.id}`}>
                {post.data.title}
              </a>
              <p class="toc-desc">{post.data.description}</p>
            </div>
            <div class="toc-tags">
              {post.data.tags.map((tag) => (
                <a class="tag" href={`/tags/${tag}`}>{tag}</a>
              ))}
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  .cover {
    padding: 64px 0 36px;
  }

  .cover-kicker {
    font-family: var(--sans);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 16px;
  }

  .cover-title {
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(3.5rem, 12vw, 7rem);
    line-height: 0.95;
    letter-spacing: -0.03em;
    margin: 0 0 24px;
  }

  .cover-lead {
    max-width: 640px;
    margin: 0;
  }

  .section {
    margin-top: 64px;
  }

  /* ---- 非对称项目网格 ---- */
  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }

  .feature-card {
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }

  .feature-card.wide {
    grid-column: 1 / -1;
  }

  .feature-letter {
    flex: none;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.8rem;
    color: var(--accent-contrast);
    background-color: var(--accent);
    border-radius: 4px;
  }

  .feature-body {
    min-width: 0;
  }

  /* ---- 目录式列表 ---- */
  .toc {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 20px;
    align-items: baseline;
    padding: 18px 0;
    border-top: 1px solid var(--border);
  }

  .toc-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .toc-date {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .toc-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.25rem;
    color: var(--text);
    text-decoration: none;
    transition: color var(--t-base) ease;
  }

  .toc-title:hover {
    color: var(--accent);
  }

  .toc-desc {
    margin: 6px 0 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .toc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-content: start;
    justify-content: flex-end;
  }

  @media (max-width: 900px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }

    .toc-item {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .toc-tags {
      justify-content: flex-start;
    }
  }
</style>
