---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const featuredProjects = (await getCollection("projects"))
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const latestPosts = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);

const formatDate = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });

const issueDate = new Date().toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
});
---

<Base
  title="Ze'Yan · 个人站点"
  description="Ze'Yan · AI 驱动的全栈工程师，关注智能体工作流、Linux 与 Web 开发"
>
  <section class="cover reveal" style="--reveal-delay: 0ms">
    <div class="cover-top-rule" aria-hidden="true"></div>
    <div class="cover-meta">
      <span class="cover-meta-item">Vol. I</span>
      <span class="cover-meta-sep" aria-hidden="true">·</span>
      <span class="cover-meta-item">{issueDate}</span>
      <span class="cover-meta-sep" aria-hidden="true">·</span>
      <span class="cover-meta-item">No. 001</span>
    </div>
    <p class="cover-kicker">个人站点 · PORTFOLIO & WRITING</p>
    <h1 class="cover-title">Ze'Yan</h1>
    <div class="cover-title-rule" aria-hidden="true"></div>
    <p class="lead cover-lead">
      AI 驱动的全栈工程师。这里汇集我的项目、文章与一些慢思考——像一本持续排印的杂志。
    </p>
  </section>

  <hr class="rule" />

  <section class="section reveal" style="--reveal-delay: 80ms">
    <div class="section-head">
      <div>
        <p class="section-kicker">精选项目</p>
        <h2>近期在做</h2>
      </div>
      <a href="/projects" class="more">查看全部 →</a>
    </div>

    <div class="feature-grid">
      {
        featuredProjects.map((project, i) => (
          <article
            class:list={["feature-card", "card", { wide: i % 3 === 0 }]}
          >
            <span class="feature-letter" aria-hidden="true">
              {project.data.title.charAt(0)}
            </span>
            <div class="feature-body">
              <h3>
                <a href={`/projects/${project.data.slug ?? project.id}`}>
                  {project.data.title}
                </a>
              </h3>
              <p>{project.data.description}</p>
              <div class="tags">
                {project.data.tags.map((tag) => (
                  <a class="tag" href={`/tags/${tag}`}>{tag}</a>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section reveal" style="--reveal-delay: 160ms">
    <div class="section-head">
      <div>
        <p class="section-kicker">最新文章</p>
        <h2>本期目录</h2>
      </div>
      <a href="/blog" class="more">查看全部 →</a>
    </div>

    <ol class="toc">
      {
        latestPosts.map((post, i) => (
          <li class="toc-item">
            <span class="toc-idx" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
            <time class="toc-date">{formatDate(post.data.pubDate)}</time>
            <div class="toc-main">
              <a class="toc-title" href={`/blog/${post.id}`}>
                {post.data.title}
              </a>
              <p class="toc-desc">{post.data.description}</p>
            </div>
            <div class="toc-tags">
              {post.data.tags.map((tag) => (
                <a class="tag" href={`/tags/${tag}`}>{tag}</a>
              ))}
            </div>
          </li>
        ))
      }
    </ol>
  </section>
</Base>

<style>
  /* ============================================================
     COVER — MAGAZINE COVER TREATMENT
     ============================================================ */
  .cover {
    padding: 48px 0 36px;
  }

  .cover-top-rule {
    height: 4px;
    background: var(--text);
    margin-bottom: 20px;
  }

  .cover-meta {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 14px;
  }

  .cover-meta-item {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-2);
    font-weight: 600;
  }

  .cover-meta-sep {
    color: var(--border);
    font-size: 0.9rem;
  }

  .cover-kicker {
    font-family: var(--sans);
    text-transform: uppercase;
    letter-spacing: 0.22em;
    font-size: 0.74rem;
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 12px;
  }

  .cover-title {
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(4rem, 14vw, 8.5rem);
    line-height: 0.92;
    letter-spacing: -0.04em;
    margin: 0 0 16px;
    color: var(--text);
  }

  .cover-title-rule {
    height: 3px;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent-2) 100%);
    margin-bottom: 20px;
    max-width: 200px;
  }

  .cover-lead {
    max-width: 640px;
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.55;
  }

  /* ============================================================
     SECTION & FEATURE GRID
     ============================================================ */
  .section {
    margin-top: 64px;
  }

  .feature-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }

  .feature-card {
    display: flex;
    gap: 18px;
    align-items: flex-start;
  }

  .feature-card.wide {
    grid-column: 1 / -1;
  }

  /* 杂志大写首字母 — 有装饰层次 */
  .feature-letter {
    flex: none;
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.8rem;
    color: var(--accent-contrast);
    background-color: var(--accent);
    border-radius: 4px;
    position: relative;
  }

  .feature-letter::after {
    content: "";
    position: absolute;
    inset: 3px;
    border: 1px solid color-mix(in srgb, var(--accent-contrast) 25%, transparent);
    border-radius: 2px;
    pointer-events: none;
  }

  .feature-body {
    min-width: 0;
  }

  .feature-body h3 {
    margin: 0;
  }

  .feature-body h3 a {
    color: var(--text);
    text-decoration: none;
    transition: color var(--t-base) ease;
  }

  .feature-body h3 a:hover {
    color: var(--accent);
  }

  .feature-body p {
    margin: 6px 0 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  @media (max-width: 900px) {
    .feature-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .cover-title {
      font-size: clamp(3rem, 12vw, 5rem);
    }

    .feature-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
