---
import Base from "../layouts/Base.astro";
import { getCollection } from "astro:content";

const recent = (await getCollection("blog", ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);

const formatDate = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
---

<Base title="404 · 页面走丢了" description="页面未找到">
  <section class="notfound reveal">
    <div class="notfound-top-rule" aria-hidden="true"></div>
    <p class="section-kicker">迷路了</p>
    <h1 class="code">404</h1>
    <div class="notfound-title-rule" aria-hidden="true"></div>
    <p class="lead msg">
      这一页大概被排版时夹进了另一期杂志——或者它从未存在过。
    </p>
    <p class="sub">
      别担心，好内容都还安稳地躺在下面这些地方。
    </p>
    <div class="links">
      <a class="nf-btn primary" href="/">回到首页</a>
      <a class="nf-btn" href="/blog">读读博客</a>
      <a class="nf-btn" href="/search">站内搜索</a>
    </div>

    {
      recent.length > 0 && (
        <div class="recent">
          <p class="recent-label">近期文章</p>
          <ul class="recent-list">
            {recent.map((p, i) => (
              <li>
                <a href={`/blog/${p.id}`}>
                  <span class="recent-idx">{String(i + 1).padStart(2, "0")}</span>
                  <span class="recent-date">{formatDate(p.data.pubDate)}</span>
                  <span class="recent-title">{p.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </section>
</Base>

<style>
  .notfound {
    min-height: 56vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 64px 0;
  }

  .notfound-top-rule {
    height: 4px;
    background: var(--text);
    width: 100%;
    max-width: 560px;
    margin-bottom: 32px;
  }

  .code {
    font-family: var(--serif);
    font-weight: 700;
    font-size: clamp(6rem, 22vw, 12rem);
    line-height: 0.85;
    letter-spacing: -0.04em;
    margin: 10px 0 12px;
    color: var(--accent);
  }

  .notfound-title-rule {
    height: 3px;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent-2) 100%);
    margin-bottom: 20px;
    max-width: 120px;
  }

  .msg {
    max-width: 480px;
    margin: 0 auto;
  }

  .sub {
    color: var(--text-muted);
    margin: 12px 0 28px;
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
  }

  .nf-btn {
    font: inherit;
    font-size: 0.92rem;
    letter-spacing: 0.04em;
    color: var(--text);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 9px 20px;
    text-decoration: none;
    transition: color var(--t-base) ease, border-color var(--t-base) ease,
      background-color var(--t-base) ease, transform var(--t-base) ease;
  }

  .nf-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  .nf-btn:active {
    transform: scale(0.98);
  }

  .nf-btn.primary {
    color: var(--accent-contrast);
    background-color: var(--accent);
    border-color: var(--accent);
  }

  .nf-btn.primary:hover {
    color: var(--accent-contrast);
    filter: brightness(1.06);
  }

  .recent {
    margin-top: 40px;
    padding-top: 24px;
    width: 100%;
    max-width: 560px;
    border-top: 2px solid var(--text);
    text-align: left;
  }

  .recent-label {
    margin: 0 0 12px;
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-2);
    font-weight: 600;
  }

  .recent-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .recent-list li a {
    display: flex;
    align-items: baseline;
    gap: 10px;
    padding: 10px 0;
    color: var(--text);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
    transition: color var(--t-base) ease;
  }

  .recent-list li:last-child a {
    border-bottom: none;
  }

  .recent-list li a:hover .recent-title {
    color: var(--accent);
  }

  .recent-idx {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 0.85rem;
    color: var(--border);
    min-width: 20px;
  }

  .recent-date {
    flex-shrink: 0;
    font-family: var(--sans);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .recent-title {
    font-family: var(--serif);
    font-size: 0.98rem;
    line-height: 1.5;
    transition: color var(--t-base) ease;
  }
</style>
