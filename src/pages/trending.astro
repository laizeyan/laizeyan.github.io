---
// src/pages/trending.astro
import Base from "../layouts/Base.astro";
import trendingRaw from "../data/trending-data.json";

interface Repo {
  owner: string;
  repo: string;
  url: string;
  description: string;
  language: string;
  langColor: string;
  stars: number;
  forks: number;
  todayStars: number;
}

interface WeekData {
  weekId: string;
  startDate: string;
  endDate: string;
  fetchedAt: string;
  repos: Repo[];
}

const weeks: WeekData[] = (trendingRaw as { weeks: WeekData[] }).weeks || [];
const latestWeek = weeks[0] || { repos: [] };
const initialRepos = latestWeek.repos || [];

function formatDate(dateStr: string) {
  if (!dateStr) return "";
  const d = new Date(dateStr);
  return `${d.getMonth() + 1}月${d.getDate()}日`;
}

function formatNum(num: number) {
  if (num >= 1000) {
    return (num / 1000).toFixed(1).replace(/\.0$/, "") + "k";
  }
  return String(num);
}

// 初始分段 (Bento Grid)
const top1 = initialRepos[0];
const top2_3 = initialRepos.slice(1, 3);
const restRepos = initialRepos.slice(3);

// 统计初始周次编程语言
const initialLangCounts: Record<string, number> = {};
initialRepos.forEach((r) => {
  if (r.language) {
    initialLangCounts[r.language] = (initialLangCounts[r.language] || 0) + 1;
  }
});
const initialLangs = Object.keys(initialLangCounts).sort();
---

<Base
  title="GitHub 每周热榜 · Ze'Yan"
  description="GitHub 每周排名前列的热门开源项目精选与技术趋势"
>
  <article class="prose trending-page reveal">
    <header class="trending-head">
      <div class="trending-head-accent" aria-hidden="true"></div>
      <p class="section-kicker">开源周刊</p>
      <h1>GitHub 热榜</h1>
      <p class="lead">
        每周精选 GitHub 增长最快的前沿开源项目，追踪全球技术浪潮与工程范式。
      </p>
    </header>

    <hr class="rule" />

    <!-- 交互筛选与周次选择栏 -->
    <div class="trending-controls">
      <div class="control-group">
        <label for="week-select" class="control-label">选择周次</label>
        <div class="select-wrapper">
          <select id="week-select" class="trending-select" aria-label="选择历史周次">
            {
              weeks.map((w, idx) => (
                <option value={idx}>
                  {w.weekId} ({formatDate(w.startDate)} - {formatDate(w.endDate)})
                </option>
              ))
            }
          </select>
        </div>
      </div>

      <!-- 语言过滤标签栏 -->
      <div class="lang-filter-wrap">
        <span class="control-label">语言筛选</span>
        <div class="lang-tags" id="lang-tags-container">
          <button class="lang-tag active" data-lang="">全部 ({initialRepos.length})</button>
          {
            initialLangs.map((lang) => (
              <button class="lang-tag" data-lang={lang}>
                {lang} ({initialLangCounts[lang]})
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- 仓库 Bento Grid 列表容器 (SSR 初始直出) -->
    <div id="repos-container" class="trending-bento-wrap">
      {
        initialRepos.length === 0 ? (
          <div class="empty-state">
            <p>当前分类下暂无项目记录。</p>
          </div>
        ) : (
          <>
            {top1 && (
              <div class="trending-hero-card">
                <div class="hero-top-badge">
                  <span class="hero-crown">👑 TOP 01 · 本周热度榜首</span>
                  {top1.todayStars > 0 && (
                    <span class="hero-growth-badge" title="本周 Star 激增">
                      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                      +{formatNum(top1.todayStars)} 本周增长
                    </span>
                  )}
                </div>
                
                <div class="hero-main-content">
                  <div class="hero-text-block">
                    <div class="hero-author-kicker">
                      <span class="hero-owner">{top1.owner}</span>
                      <span class="hero-slash">/</span>
                    </div>
                    <h2 class="hero-repo-title">
                      <a href={top1.url} target="_blank" rel="noopener noreferrer" class="hero-repo-link">
                        {top1.repo}
                        <svg class="external-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                      </a>
                    </h2>
                    {top1.description && <p class="hero-repo-desc">{top1.description}</p>}
                  </div>
                </div>

                <div class="hero-meta-footer">
                  <div class="hero-stats">
                    {top1.language && (
                      <span class="meta-item hero-lang">
                        <span class="lang-dot" style={{ backgroundColor: top1.langColor || "var(--accent)" }}></span>
                        {top1.language}
                      </span>
                    )}
                    <span class="meta-item" title="总 Star 数">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                      {formatNum(top1.stars)}
                    </span>
                    <span class="meta-item" title="Fork 数">
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"/><path d="M12 12v3"/></svg>
                      {formatNum(top1.forks)}
                    </span>
                  </div>
                  <a href={top1.url} target="_blank" rel="noopener noreferrer" class="hero-action-btn">
                    查看项目 ➔
                  </a>
                </div>
              </div>
            )}

            {top2_3.length > 0 && (
              <div class="trending-spotlight-grid">
                {top2_3.map((repo, idx) => {
                  const rankNum = idx + 2;
                  const rankStr = String(rankNum).padStart(2, "0");
                  return (
                    <div class:list={["spotlight-card", `is-rank-${rankNum}`]}>
                      <div class="spotlight-header">
                        <span class="spotlight-rank">TOP {rankStr}</span>
                        {repo.todayStars > 0 && (
                          <span class="spotlight-growth">+{formatNum(repo.todayStars)}</span>
                        )}
                      </div>
                      <h3 class="spotlight-title">
                        <a href={repo.url} target="_blank" rel="noopener noreferrer">
                          <span class="repo-owner">{repo.owner} / </span>{repo.repo}
                        </a>
                      </h3>
                      {repo.description && <p class="spotlight-desc">{repo.description}</p>}
                      <div class="spotlight-meta">
                        {repo.language && (
                          <span class="meta-item">
                            <span class="lang-dot" style={{ backgroundColor: repo.langColor || "var(--accent)" }}></span>
                            {repo.language}
                          </span>
                        )}
                        <span class="meta-item">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                          {formatNum(repo.stars)}
                        </span>
                        <span class="meta-item">
                          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"/><path d="M12 12v3"/></svg>
                          {formatNum(repo.forks)}
                        </span>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}

            {restRepos.length > 0 && (
              <div class="trending-dense-grid">
                {restRepos.map((repo, idx) => {
                  const rankNum = idx + 4;
                  const rankStr = String(rankNum).padStart(2, "0");
                  return (
                    <div class="dense-repo-card">
                      <div class="dense-card-top">
                        <span class="dense-rank">{rankStr}</span>
                        <div class="dense-title-wrap">
                          <a href={repo.url} target="_blank" rel="noopener noreferrer" class="dense-repo-link">
                            <span class="dense-owner">{repo.owner} / </span><span class="dense-name">{repo.repo}</span>
                          </a>
                        </div>
                        {repo.todayStars > 0 && (
                          <span class="dense-growth">+{formatNum(repo.todayStars)}</span>
                        )}
                      </div>
                      {repo.description && <p class="dense-desc">{repo.description}</p>}
                      <div class="dense-meta">
                        {repo.language && (
                          <span class="meta-item">
                            <span class="lang-dot" style={{ backgroundColor: repo.langColor || "var(--accent)" }}></span>
                            {repo.language}
                          </span>
                        )}
                        <span class="meta-item">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                          {formatNum(repo.stars)}
                        </span>
                        <span class="meta-item">
                          <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"/><path d="M12 12v3"/></svg>
                          {formatNum(repo.forks)}
                        </span>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}
          </>
        )
      }
    </div>
  </article>

  <!-- 序列化历史周次数据供客户端切换周次和语言筛选 -->
  <script is:inline id="trending-json" type="application/json" set:html={JSON.stringify(weeks)} />

  <script>
    function setupTrending() {
      const dataEl = document.getElementById("trending-json");
      const reposContainer = document.getElementById("repos-container");
      const selectEl = document.getElementById("week-select") as HTMLSelectElement | null;
      const langContainer = document.getElementById("lang-tags-container");

      if (!dataEl || !reposContainer || !selectEl || !langContainer) return;

      let weeks: any[] = [];
      try {
        weeks = JSON.parse(dataEl.textContent || "[]");
      } catch {
        return;
      }
      if (!weeks.length) return;

      let currentWeekIndex = parseInt(selectEl.value, 10) || 0;
      let currentLang = "";

      function formatNum(num: number) {
        if (num >= 1000) {
          return (num / 1000).toFixed(1).replace(/\.0$/, "") + "k";
        }
        return String(num);
      }

      function escapeHtml(s: string) {
        return (s || "")
          .replace(/&/g, "&amp;")
          .replace(/</g, "&lt;")
          .replace(/>/g, "&gt;")
          .replace(/"/g, "&quot;")
          .replace(/'/g, "&#039;");
      }

      function updateLanguageTags(repos: any[]) {
        const langSet = new Set<string>();
        repos.forEach((r) => {
          if (r.language) langSet.add(r.language);
        });
        const langs = Array.from(langSet).sort();

        let html = `<button class="lang-tag ${currentLang === "" ? "active" : ""}" data-lang="">全部 (${repos.length})</button>`;
        langs.forEach((lang) => {
          const count = repos.filter((r) => r.language === lang).length;
          html += `<button class="lang-tag ${currentLang === lang ? "active" : ""}" data-lang="${escapeHtml(lang)}">${escapeHtml(lang)} (${count})</button>`;
        });
        langContainer!.innerHTML = html;

        bindLangTagEvents();
      }

      function bindLangTagEvents() {
        langContainer!.querySelectorAll(".lang-tag").forEach((btn) => {
          btn.addEventListener("click", () => {
            currentLang = btn.getAttribute("data-lang") || "";
            langContainer!.querySelectorAll(".lang-tag").forEach((b) => b.classList.remove("active"));
            btn.classList.add("active");
            renderRepos();
          });
        });
      }

      function renderRepos() {
        const week = weeks[currentWeekIndex];
        if (!week) return;

        let filtered = week.repos || [];
        if (currentLang) {
          filtered = filtered.filter((r: any) => r.language === currentLang);
        }

        if (!filtered.length) {
          reposContainer!.innerHTML = `
            <div class="empty-state">
              <p>当前分类下暂无项目记录。</p>
            </div>
          `;
          return;
        }

        const top1 = filtered[0];
        const top2_3 = filtered.slice(1, 3);
        const rest = filtered.slice(3);

        let html = "";

        // 1. Top 1 Hero Card
        if (top1) {
          html += `
            <div class="trending-hero-card">
              <div class="hero-top-badge">
                <span class="hero-crown">👑 TOP 01 · 本周热度榜首</span>
                ${
                  top1.todayStars > 0
                    ? `<span class="hero-growth-badge" title="本周 Star 激增">
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>
                        +${formatNum(top1.todayStars)} 本周增长
                      </span>`
                    : ""
                }
              </div>
              <div class="hero-main-content">
                <div class="hero-text-block">
                  <div class="hero-author-kicker">
                    <span class="hero-owner">${escapeHtml(top1.owner)}</span>
                    <span class="hero-slash">/</span>
                  </div>
                  <h2 class="hero-repo-title">
                    <a href="${escapeHtml(top1.url)}" target="_blank" rel="noopener noreferrer" class="hero-repo-link">
                      ${escapeHtml(top1.repo)}
                      <svg class="external-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
                    </a>
                  </h2>
                  ${top1.description ? `<p class="hero-repo-desc">${escapeHtml(top1.description)}</p>` : ""}
                </div>
              </div>
              <div class="hero-meta-footer">
                <div class="hero-stats">
                  ${
                    top1.language
                      ? `<span class="meta-item hero-lang">
                          <span class="lang-dot" style="background-color: ${escapeHtml(top1.langColor || "var(--accent)")}"></span>
                          ${escapeHtml(top1.language)}
                        </span>`
                      : ""
                  }
                  <span class="meta-item" title="总 Star 数">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    ${formatNum(top1.stars)}
                  </span>
                  <span class="meta-item" title="Fork 数">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"/><path d="M12 12v3"/></svg>
                    ${formatNum(top1.forks)}
                  </span>
                </div>
                <a href="${escapeHtml(top1.url)}" target="_blank" rel="noopener noreferrer" class="hero-action-btn">
                  查看项目 ➔
                </a>
              </div>
            </div>
          `;
        }

        // 2. Spotlight Grid
        if (top2_3.length > 0) {
          html += '<div class="trending-spotlight-grid">';
          top2_3.forEach((repo: any, idx: number) => {
            const rankNum = idx + 2;
            const rankStr = String(rankNum).padStart(2, "0");
            html += `
              <div class="spotlight-card is-rank-${rankNum}">
                <div class="spotlight-header">
                  <span class="spotlight-rank">TOP ${rankStr}</span>
                  ${repo.todayStars > 0 ? `<span class="spotlight-growth">+${formatNum(repo.todayStars)}</span>` : ""}
                </div>
                <h3 class="spotlight-title">
                  <a href="${escapeHtml(repo.url)}" target="_blank" rel="noopener noreferrer">
                    <span class="repo-owner">${escapeHtml(repo.owner)} / </span>${escapeHtml(repo.repo)}
                  </a>
                </h3>
                ${repo.description ? `<p class="spotlight-desc">${escapeHtml(repo.description)}</p>` : ""}
                <div class="spotlight-meta">
                  ${
                    repo.language
                      ? `<span class="meta-item">
                          <span class="lang-dot" style="background-color: ${escapeHtml(repo.langColor || "var(--accent)")}"></span>
                          ${escapeHtml(repo.language)}
                        </span>`
                      : ""
                  }
                  <span class="meta-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    ${formatNum(repo.stars)}
                  </span>
                  <span class="meta-item">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"/><path d="M12 12v3"/></svg>
                    ${formatNum(repo.forks)}
                  </span>
                </div>
              </div>
            `;
          });
          html += "</div>";
        }

        // 3. Dense Bento Grid
        if (rest.length > 0) {
          html += '<div class="trending-dense-grid">';
          rest.forEach((repo: any, idx: number) => {
            const rankNum = idx + 4;
            const rankStr = String(rankNum).padStart(2, "0");
            html += `
              <div class="dense-repo-card">
                <div class="dense-card-top">
                  <span class="dense-rank">${rankStr}</span>
                  <div class="dense-title-wrap">
                    <a href="${escapeHtml(repo.url)}" target="_blank" rel="noopener noreferrer" class="dense-repo-link">
                      <span class="dense-owner">${escapeHtml(repo.owner)} / </span><span class="dense-name">${escapeHtml(repo.repo)}</span>
                    </a>
                  </div>
                  ${repo.todayStars > 0 ? `<span class="dense-growth">+${formatNum(repo.todayStars)}</span>` : ""}
                </div>
                ${repo.description ? `<p class="dense-desc">${escapeHtml(repo.description)}</p>` : ""}
                <div class="dense-meta">
                  ${
                    repo.language
                      ? `<span class="meta-item">
                          <span class="lang-dot" style="background-color: ${escapeHtml(repo.langColor || "var(--accent)")}"></span>
                          ${escapeHtml(repo.language)}
                        </span>`
                      : ""
                  }
                  <span class="meta-item">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                    ${formatNum(repo.stars)}
                  </span>
                  <span class="meta-item">
                    <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="18" r="3"/><circle cx="6" cy="6" r="3"/><circle cx="18" cy="6" r="3"/><path d="M18 9v1a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2V9"/><path d="M12 12v3"/></svg>
                    ${formatNum(repo.forks)}
                  </span>
                </div>
              </div>
            `;
          });
          html += "</div>";
        }

        reposContainer!.innerHTML = html;
      }

      selectEl.addEventListener("change", (e) => {
        currentWeekIndex = parseInt((e.target as HTMLSelectElement).value, 10) || 0;
        currentLang = "";
        updateLanguageTags(weeks[currentWeekIndex].repos || []);
        renderRepos();
      });

      bindLangTagEvents();
    }

    document.addEventListener("astro:page-load", setupTrending);
  </script>
</Base>

<style>
  .trending-page {
    padding: 40px 0;
    max-width: 100%;
    width: 100%;
  }

  .trending-head {
    position: relative;
    padding-left: 20px;
  }

  .trending-head-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, var(--accent) 0%, var(--accent-2) 100%);
    border-radius: 2px;
  }

  .trending-head h1 {
    font-size: clamp(2.8rem, 7vw, 4.5rem);
    margin: 8px 0 16px;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .trending-controls {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin: 28px 0 32px;
    padding: 18px 20px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 6px;
    box-shadow: var(--shadow-sm);
  }

  .control-group {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .control-label {
    font-family: var(--sans);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    min-width: 65px;
  }

  .select-wrapper {
    position: relative;
    flex: 1;
    max-width: 380px;
  }

  .trending-select {
    width: 100%;
    padding: 7px 14px;
    font-family: var(--sans);
    font-size: 0.9rem;
    background-color: var(--bg);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 4px;
    outline: none;
    cursor: pointer;
    transition: border-color var(--t-base) ease, box-shadow var(--t-base) ease;
  }

  .trending-select:focus {
    border-color: var(--accent);
    box-shadow: 0 0 0 3px rgba(180, 69, 46, 0.15);
  }

  .lang-filter-wrap {
    display: flex;
    align-items: flex-start;
    gap: 12px;
  }

  .lang-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  :global(.lang-tag) {
    font-family: var(--sans);
    font-size: 0.8rem;
    padding: 4px 10px;
    background-color: var(--bg);
    color: var(--text-muted);
    border: 1px solid var(--border);
    border-radius: 3px;
    cursor: pointer;
    transition: all var(--t-fast) ease;
  }

  :global(.lang-tag:hover) {
    color: var(--text);
    border-color: var(--text-muted);
    transform: translateY(-1px);
  }

