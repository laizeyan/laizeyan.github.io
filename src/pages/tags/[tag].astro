---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const tags = Array.from(
    new Set(posts.flatMap((post) => post.data.tags))
  ).sort();
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts },
  }));
}

const { tag, posts } = Astro.props;
const tagged = posts
  .filter((post) => post.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags))
).sort();

const formatDate = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
---

<Base
  title={`标签：${tag} · Ze'Yan`}
  description={`标签「${tag}」下的所有文章`}
>
  <header class="page-head reveal">
    <p class="section-kicker">标签</p>
    <h1>#{tag}</h1>
    <p class="lead page-lead">
      共 {tagged.length} 篇与「{tag}」相关的文章，按时间倒序排印。
    </p>
  </header>

  <hr class="rule" />

  <div class="tag-filter reveal" role="group" aria-label="标签筛选">
    <a class="tag-btn" href="/tags" data-tag="*">全部</a>
    {
      allTags.map((t) => (
        <a
          class:list={["tag-btn", { active: t === tag }]}
          href={`/tags/${t}`}
          data-tag={t}
        >
          {t}
        </a>
      ))
    }
  </div>

  <ol class="toc reveal">
    {
      tagged.map((post, i) => (
        <li class="toc-item" data-tags={post.data.tags.join(",")}>
          <span class="toc-idx" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <time class="toc-date">{formatDate(post.data.pubDate)}</time>
          <div class="toc-main">
            <a class="toc-title" href={`/blog/${post.id}`}>
              {post.data.title}
            </a>
            <p class="toc-desc">{post.data.description}</p>
          </div>
          <div class="toc-tags">
            {post.data.tags.map((t) => (
              <a class="tag" href={`/tags/${t}`}>
                {t}
              </a>
            ))}
          </div>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  /* 所有共享样式已移至 global.css */
</style>
