---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  const tags = Array.from(
    new Set(posts.flatMap((post) => post.data.tags))
  ).sort();
  return tags.map((tag) => ({
    params: { tag },
    props: { tag, posts },
  }));
}

const { tag, posts } = Astro.props;
const tagged = posts
  .filter((post) => post.data.tags.includes(tag))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags))
).sort();

const formatDate = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
---

<Base
  title={`标签：${tag} · Ze'Yan`}
  description={`标签「${tag}」下的所有文章`}
>
  <header class="page-head reveal">
    <p class="section-kicker">标签</p>
    <h1>#{tag}</h1>
    <p class="lead page-lead">
      共 {tagged.length} 篇与「{tag}」相关的文章，按时间倒序排印。
    </p>
  </header>

  <hr class="rule" />

  <div class="tag-filter reveal" role="group" aria-label="标签筛选">
    <a class="tag-btn" href="/tags" data-tag="*">全部</a>
    {
      allTags.map((t) => (
        <a
          class:list={["tag-btn", { active: t === tag }]}
          href={`/tags/${t}`}
          data-tag={t}
        >
          {t}
        </a>
      ))
    }
  </div>

  <ol class="toc reveal">
    {
      tagged.map((post) => (
        <li class="toc-item" data-tags={post.data.tags.join(",")}>
          <time class="toc-date">{formatDate(post.data.pubDate)}</time>
          <div class="toc-main">
            <a class="toc-title" href={`/blog/${post.id}`}>
              {post.data.title}
            </a>
            <p class="toc-desc">{post.data.description}</p>
          </div>
          <div class="toc-tags">
            {post.data.tags.map((t) => (
              <a class="tag" href={`/tags/${t}`}>
                {t}
              </a>
            ))}
          </div>
        </li>
      ))
    }
  </ol>
</Base>

<style>
  .page-head {
    padding: 40px 0 20px;
  }

  .page-head h1 {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 7vw, 4rem);
    margin: 6px 0 12px;
    letter-spacing: -0.02em;
  }

  .page-lead {
    margin: 0;
    max-width: 560px;
  }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0;
  }

  .tag-btn {
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    background-color: transparent;
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 5px 13px;
    text-decoration: none;
    transition: color var(--t-base) ease, border-color var(--t-base) ease,
      background-color var(--t-base) ease, transform var(--t-base) ease;
  }

  .tag-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
    text-decoration: none;
  }

  .tag-btn:active {
    transform: scale(0.96);
  }

  .tag-btn.active {
    color: var(--accent-contrast);
    background-color: var(--accent);
    border-color: var(--accent);
  }

  .toc {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 20px;
    align-items: baseline;
    padding: 20px 0;
    border-top: 1px solid var(--border);
  }

  .toc-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .toc-date {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .toc-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--text);
    text-decoration: none;
    transition: color var(--t-base) ease;
  }

  .toc-title:hover {
    color: var(--accent);
  }

  .toc-desc {
    margin: 6px 0 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .toc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-content: start;
    justify-content: flex-end;
  }

  .toc-tags .tag {
    text-decoration: none;
  }

  .toc-tags .tag:hover {
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .toc-item {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .toc-tags {
      justify-content: flex-start;
    }
  }
</style>
