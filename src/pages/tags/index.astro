---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags))
).sort();

const countFor = (tag: string) =>
  posts.filter((post) => post.data.tags.includes(tag)).length;
---

<Base title="标签 · Ze'Yan" description="所有文章标签">
  <header class="page-head reveal">
    <p class="section-kicker">索引</p>
    <h1>标签</h1>
    <p class="lead page-lead">按主题浏览全部文章。</p>
  </header>

  <hr class="rule" />

  <div class="tag-cloud reveal">
    {
      allTags.map((tag) => (
        <a class="tag-chip" href={`/tags/${tag}`}>
          <span>#{tag}</span>
          <span class="tag-count">{countFor(tag)}</span>
        </a>
      ))
    }
  </div>
</Base>

<style>
  .page-head {
    padding: 40px 0 20px;
  }

  .page-head h1 {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 7vw, 4rem);
    margin: 6px 0 12px;
    letter-spacing: -0.02em;
  }

  .page-lead {
    margin: 0;
    max-width: 560px;
  }

  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--text);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 8px 16px;
    text-decoration: none;
    transition: color var(--t-base) ease, border-color var(--t-base) ease,
      transform var(--t-base) ease;
  }

  .tag-chip:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
    text-decoration: none;
  }

  .tag-chip:active {
    transform: scale(0.98);
  }

  .tag-count {
    font-family: var(--sans);
    font-size: 0.78rem;
    color: var(--text-muted);
    border-left: 1px solid var(--border);
    padding-left: 8px;
  }
</style>
