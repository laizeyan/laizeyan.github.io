---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags))
).sort();

const countFor = (tag: string) =>
  posts.filter((post) => post.data.tags.includes(tag)).length;
---

<Base title="标签 · Ze'Yan" description="所有文章标签">
  <header class="page-head reveal">
    <p class="section-kicker">索引</p>
    <h1>标签</h1>
    <p class="lead page-lead">按主题浏览全部文章。</p>
  </header>

  <hr class="rule" />

  <div class="tag-cloud reveal">
    {
      allTags.map((tag) => (
        <a class="tag-chip" href={`/tags/${tag}`}>
          <span class="tag-chip-name">#{tag}</span>
          <span class="tag-count">{countFor(tag)}</span>
        </a>
      ))
    }
  </div>
</Base>

<style>
  .tag-cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--serif);
    font-size: 1.1rem;
    color: var(--text);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 10px 18px;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: color var(--t-base) ease, border-color var(--t-base) ease,
      transform var(--t-base) ease, box-shadow var(--t-base) ease;
  }

  .tag-chip:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
    box-shadow: var(--shadow-md);
    text-decoration: none;
  }

  .tag-chip:active {
    transform: scale(0.98);
  }

  .tag-chip-name {
    font-weight: 600;
  }

  .tag-count {
    font-family: var(--sans);
    font-size: 0.78rem;
    color: var(--text-muted);
    border-left: 1px solid var(--border);
    padding-left: 10px;
    min-width: 18px;
    text-align: center;
    background-color: var(--accent-2);
    color: var(--accent-2-contrast);
    border-radius: 2px;
    padding: 1px 6px;
    border-left: none;
  }
</style>
