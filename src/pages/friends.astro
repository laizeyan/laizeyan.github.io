---
import Base from "../layouts/Base.astro";

// 在此添加友链：name 站点名 / url 链接 / desc 一句简介
const friends: { name: string; url: string; desc: string }[] = [
  // {
  //   name: "xxx",
  //   url: "https://example.com",
  //   desc: "一句话描述",
  // },
];
---

<Base
  title="友链 · Ze'Yan"
  description="Ze'Yan 的友情链接"
>
  <article class="prose friends reveal">
    <header class="friends-head">
      <div class="friends-head-accent" aria-hidden="true"></div>
      <p class="section-kicker">友链</p>
      <h1>友情链接</h1>
      <p class="lead">
        我欣赏并关注的一些站点。想做友链，欢迎通过页面底部的邮箱联系我。
      </p>
    </header>

    <hr class="rule" />

    {
      friends.length > 0 ? (
        <div class="friends-grid">
          {
            friends.map((f) => (
              <a class="friend-card" href={f.url} target="_blank" rel="noopener noreferrer">
                <span class="friend-name">{f.name}</span>
                <span class="friend-desc">{f.desc}</span>
              </a>
            ))
          }
        </div>
      ) : (
        <div class="friends-empty">
          <span class="friends-empty-mark" aria-hidden="true">§</span>
          <p class="friends-empty-title">友链整理中</p>
          <p class="friends-empty-desc">
            我还在挑选值得长期关注的站点。等第一批友链就位，会在这里排印出来。
          </p>
        </div>
      )
    }

    <section class="friends-how">
      <h2>申请友链</h2>
      <p>
        想交换友链，欢迎发邮件到
        <a href="mailto:hi@laizeyan.github.io">hi@laizeyan.github.io</a>
        。请附上你的站点名称、链接与一句简介。
      </p>
      <ul class="friends-rules">
        <li>内容有长期价值的站点优先——技术笔记、写作、或你真正热爱的东西。</li>
        <li>站点可正常访问，无恶意或违规内容。</li>
        <li>先放上本站友链，再来找我，这样更快通过。</li>
      </ul>
    </section>
  </article>
</Base>

<style>
  .friends {
    padding: 40px 0;
  }

  .friends-head {
    position: relative;
    padding-left: 20px;
  }

  .friends-head-accent {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: linear-gradient(180deg, var(--accent) 0%, var(--accent-2) 100%);
    border-radius: 2px;
  }

  .friends-head h1 {
    font-size: clamp(2.8rem, 8vw, 4.5rem);
    margin: 8px 0 16px;
    letter-spacing: -0.025em;
    line-height: 1;
  }

  .friends-head .lead {
    margin: 0;
    max-width: 560px;
  }

  .friends-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 16px;
    margin-top: 32px;
  }

  .friend-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 20px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 4px;
    text-decoration: none;
    box-shadow: var(--shadow-sm);
    transition: border-color var(--t-base) ease, transform var(--t-base) ease,
      box-shadow var(--t-base) ease;
  }

  .friend-card:hover {
    border-color: var(--accent);
    transform: translateY(-3px);
    box-shadow: var(--shadow-lg);
  }

  .friend-card:active {
    transform: scale(0.98);
  }

  .friend-name {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.15rem;
    color: var(--text);
  }

  .friend-card:hover .friend-name {
    color: var(--accent);
  }

  .friend-desc {
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  /* 空态 */
  .friends-empty {
    margin-top: 40px;
    padding: 56px 28px;
    text-align: center;
    background-color: var(--bg-elevated);
    border: 2px dashed var(--border);
    border-radius: 4px;
    position: relative;
  }

  .friends-empty::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 20%;
    right: 20%;
    height: 3px;
    background: var(--accent);
    border-radius: 0 0 2px 2px;
  }

  .friends-empty-mark {
    display: block;
    font-family: var(--serif);
    font-size: 3rem;
    font-weight: 700;
    color: var(--accent);
    margin-bottom: 12px;
    line-height: 1;
  }

  .friends-empty-title {
    margin: 0 0 8px;
    font-family: var(--serif);
    font-size: 1.4rem;
    color: var(--text);
  }

  .friends-empty-desc {
    margin: 0 auto;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.7;
    max-width: 420px;
  }

  /* 申请友链 */
  .friends-how {
    margin-top: 48px;
    padding: 24px 28px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent-2);
    border-radius: 4px;
    box-shadow: var(--shadow-sm);
  }

  .friends-how h2 {
    font-size: 1.3rem;
    margin: 0 0 10px;
  }

  .friends-how p {
    margin: 0 0 14px;
    color: var(--text-muted);
    line-height: 1.7;
  }

  .friends-rules {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 0.95rem;
    color: var(--text-muted);
    line-height: 1.6;
  }

  .friends-rules li {
    position: relative;
    padding-left: 24px;
  }

  .friends-rules li::before {
    content: "§";
    position: absolute;
    left: 0;
    color: var(--accent-2);
    font-family: var(--serif);
    font-weight: 700;
  }
</style>
