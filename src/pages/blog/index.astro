---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags))
).sort();

const formatDate = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
---

<Base title="博客 · Ze'Yan" description="博客文章列表">
  <header class="page-head reveal">
    <p class="section-kicker">目录</p>
    <h1>博客</h1>
    <p class="lead page-lead">技术文章与随笔，按时间倒序排印。</p>
  </header>

  <hr class="rule" />

  <div class="tag-filter reveal" role="group" aria-label="标签筛选">
    <button class="tag-btn active" data-tag="*" type="button">全部</button>
    {
      allTags.map((tag) => (
        <button class="tag-btn" data-tag={tag} type="button">
          {tag}
        </button>
      ))
    }
  </div>

  <ol class="toc reveal">
    {
      posts.map((post) => (
        <li class="toc-item" data-tags={post.data.tags.join(",")}>
          <time class="toc-date">{formatDate(post.data.pubDate)}</time>
          <div class="toc-main">
            <a class="toc-title" href={`/blog/${post.id}`}>
              {post.data.title}
            </a>
            <p class="toc-desc">{post.data.description}</p>
          </div>
          <div class="toc-tags">
            {post.data.tags.map((tag) => (
              <a class="tag" href={`/tags/${tag}`}>{tag}</a>
            ))}
          </div>
        </li>
      ))
    }
  </ol>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>(".tag-btn");
  const items = document.querySelectorAll<HTMLElement>(".toc-item[data-tags]");

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      const tag = btn.dataset.tag;
      buttons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");

      items.forEach((item) => {
        const itemTags = (item.dataset.tags || "").split(",");
        const show = tag === "*" || (tag !== undefined && itemTags.includes(tag));
        item.style.display = show ? "" : "none";
      });
    });
  });
</script>

<style>
  .page-head {
    padding: 40px 0 20px;
  }

  .page-head h1 {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 7vw, 4rem);
    margin: 6px 0 12px;
    letter-spacing: -0.02em;
  }

  .page-lead {
    margin: 0;
    max-width: 560px;
  }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0;
  }

  .tag-btn {
    cursor: pointer;
    font: inherit;
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    color: var(--text-muted);
    background-color: transparent;
    border: 1px solid var(--border);
    border-radius: 2px;
    padding: 5px 13px;
    transition: all 0.15s ease;
  }

  .tag-btn:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .tag-btn.active {
    color: var(--accent-contrast);
    background-color: var(--accent);
    border-color: var(--accent);
  }

  .toc {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    display: grid;
    grid-template-columns: 110px 1fr auto;
    gap: 20px;
    align-items: baseline;
    padding: 20px 0;
    border-top: 1px solid var(--border);
  }

  .toc-item:last-child {
    border-bottom: 1px solid var(--border);
  }

  .toc-date {
    color: var(--text-muted);
    font-size: 0.85rem;
    font-variant-numeric: tabular-nums;
  }

  .toc-title {
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.3rem;
    color: var(--text);
    text-decoration: none;
  }

  .toc-title:hover {
    color: var(--accent);
  }

  .toc-desc {
    margin: 6px 0 0;
    color: var(--text-muted);
    font-size: 0.92rem;
  }

  .toc-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-content: start;
    justify-content: flex-end;
  }

  .toc-tags .tag {
    text-decoration: none;
  }

  .toc-tags .tag:hover {
    text-decoration: none;
  }

  @media (max-width: 720px) {
    .toc-item {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .toc-tags {
      justify-content: flex-start;
    }
  }
</style>
