---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const allTags = Array.from(
  new Set(posts.flatMap((post) => post.data.tags))
).sort();

// 「加载更多」每次揭示的条数；文章超过一屏后按钮才出现
const perPage = 8;

const formatDate = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
---

<Base title="博客 · Ze'Yan" description="博客文章列表">
  <header class="page-head reveal">
    <p class="section-kicker">目录</p>
    <h1>博客</h1>
    <p class="lead page-lead">技术文章与随笔，按时间倒序排印。</p>
  </header>

  <hr class="rule" />

  <div class="tag-filter reveal" role="group" aria-label="标签筛选">
    <button class="tag-btn active" data-tag="*" type="button">全部</button>
    {
      allTags.map((tag) => (
        <button class="tag-btn" data-tag={tag} type="button">
          {tag}
        </button>
      ))
    }
  </div>

  <ol class="toc reveal">
    {
      posts.map((post, i) => (
        <li class="toc-item" data-tags={post.data.tags.join(",")} data-index={i}>
          <span class="toc-idx" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <time class="toc-date">{formatDate(post.data.pubDate)}</time>
          <div class="toc-main">
            <a class="toc-title" href={`/blog/${post.id}`}>
              {post.data.title}
            </a>
            <p class="toc-desc">{post.data.description}</p>
          </div>
          <div class="toc-tags">
            {post.data.tags.map((tag) => (
              <a class="tag" href={`/tags/${tag}`}>{tag}</a>
            ))}
          </div>
        </li>
      ))
    }
  </ol>

  {
    posts.length > perPage && (
      <div class="more-wrap">
        <button id="load-more" class="load-more" type="button">
          加载更多
        </button>
      </div>
    )
  }
</Base>

<script>
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>(".tag-btn"));
  const items = Array.from(
    document.querySelectorAll<HTMLElement>(".toc-item[data-tags]")
  );
  const loadMoreBtn = document.querySelector<HTMLButtonElement>("#load-more");

  const perPage = 8;
  let currentTag = "*";
  let shown = perPage;

  const apply = () => {
    items.forEach((item) => {
      const idx = Number(item.dataset.index ?? 0);
      const itemTags = (item.dataset.tags || "").split(",");
      const matchesTag =
        currentTag === "*" || itemTags.includes(currentTag);
      const within = idx < shown;
      item.style.display = matchesTag && within ? "" : "none";
    });

    // 按钮状态：还有未展示的条目才显示
    const remaining = items.filter((item) => {
      const idx = Number(item.dataset.index ?? 0);
      const itemTags = (item.dataset.tags || "").split(",");
      return (
        idx >= shown &&
        (currentTag === "*" || itemTags.includes(currentTag))
      );
    }).length;
    if (loadMoreBtn) {
      loadMoreBtn.style.display = remaining > 0 ? "" : "none";
    }
  };

  buttons.forEach((btn) => {
    btn.addEventListener("click", () => {
      currentTag = btn.dataset.tag ?? "*";
      buttons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      apply();
    });
  });

  loadMoreBtn?.addEventListener("click", () => {
    shown += perPage;
    apply();
  });

  apply();
</script>

<style>
  /* page-head, tag-filter, tag-btn, toc, toc-item, toc-date, toc-title,
     toc-desc, toc-tags, toc-idx, load-more, more-wrap — all in global.css */

  /* 本页特有覆写 */
</style>
