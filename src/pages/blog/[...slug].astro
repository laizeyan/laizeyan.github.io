---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const allPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf()
);
const index = allPosts.findIndex((p) => p.id === post.id);
const prevPost = index > 0 ? allPosts[index - 1] : null;
const nextPost = index < allPosts.length - 1 ? allPosts[index + 1] : null;

// 相关文章：按共享标签加权（同标签越多越靠前），排除当前，取最近 3 篇
const related = (() => {
  const others = allPosts.filter((p) => p.id !== post.id);
  const myTags = new Set(post.data.tags);
  const scored = others
    .map((p) => ({
      post: p,
      score: p.data.tags.filter((t) => myTags.has(t)).length,
    }))
    .filter((s) => s.score > 0)
    .sort((a, b) => {
      if (b.score !== a.score) return b.score - a.score;
      return b.post.data.pubDate.valueOf() - a.post.data.pubDate.valueOf();
    })
    .slice(0, 3)
    .map((s) => s.post);
  return scored;
})();

const readingMinutes = (() => {
  const raw = (post.body ?? "")
    .replace(/```[\s\S]*?```/g, "")
    .replace(/`[^`]*`/g, "")
    .replace(/[#>*_~\-]/g, "")
    .replace(/\s/g, "");
  return Math.max(1, Math.round(raw.length / 350));
})();

const formatDate = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });

// 仅当 updatedDate 明确晚于 pubDate（跨天）时才展示「更新于」
const updated =
  post.data.updatedDate &&
  new Date(post.data.updatedDate).getTime() -
    new Date(post.data.pubDate).getTime() >
    24 * 60 * 60 * 1000
    ? new Date(post.data.updatedDate)
    : null;
---

<Base title={post.data.title} description={post.data.description}>
  <div class="reading-progress" aria-hidden="true">
    <div class="reading-progress-bar"></div>
  </div>
  <article class="prose post reveal">
    <header class="post-header">
      <p class="section-kicker">文章</p>
      <h1>{post.data.title}</h1>
      <div class="post-meta">
        <time>{formatDate(post.data.pubDate)}</time>
        {
          updated && (
            <span class="updated-time" title={`首发 ${formatDate(post.data.pubDate)}`}>
              更新于 {formatDate(updated)}
            </span>
          )
        }
        <span class="reading-time">约 {readingMinutes} 分钟阅读</span>
        {
          post.data.tags.length > 0 && (
            <span class="tags">
              {post.data.tags.map((tag) => (
                <a class="tag" href={`/tags/${tag}`}>
                  {tag}
                </a>
              ))}
            </span>
          )
        }
      </div>
    </header>
    <hr class="rule" />
    <nav class="post-toc" aria-label="文章目录">
      <p class="toc-label">本页目录</p>
      <ol class="toc-list"></ol>
    </nav>
    <div class="post-body">
      <Content />
    </div>

    <nav class="post-nav" aria-label="上一篇 / 下一篇">
      <div class="post-nav-item">
        {
          prevPost && (
            <a href={`/blog/${prevPost.id}`} class="post-nav-link prev">
              <span class="post-nav-dir">← 上一篇</span>
              <span class="post-nav-title">{prevPost.data.title}</span>
            </a>
          )
        }
      </div>
      <div class="post-nav-item next">
        {
          nextPost && (
            <a href={`/blog/${nextPost.id}`} class="post-nav-link next">
              <span class="post-nav-dir">下一篇 →</span>
              <span class="post-nav-title">{nextPost.data.title}</span>
            </a>
          )
        }
      </div>
    </nav>

    {
      related.length > 0 && (
        <section class="related reveal" aria-label="相关文章">
          <p class="section-kicker">继续阅读</p>
          <h2 class="related-title">相关文章</h2>
          <ul class="related-list">
            {related.map((r) => (
              <li>
                <a href={`/blog/${r.id}`} class="related-link">
                  <span class="related-meta">
                    {formatDate(r.data.pubDate)}
                    {r.data.tags.length > 0 && (
                      <span class="related-tags">
                        {r.data.tags
                          .filter((t) => post.data.tags.includes(t))
                          .slice(0, 2)
                          .map((t) => `#${t}`)
                          .join(" ")}
                      </span>
                    )}
                  </span>
                  <span class="related-post-title">{r.data.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </article>
</Base>

<script>
  document.addEventListener("astro:page-load", () => {
    // ---- 阅读进度条 ----
    const bar = document.querySelector<HTMLElement>(
      ".reading-progress-bar"
    );
    if (bar) {
      const update = () => {
        const scrollable = document.documentElement;
        const total = scrollable.scrollHeight - scrollable.clientHeight;
        const ratio = total > 0 ? scrollable.scrollTop / total : 0;
        bar.style.width = `${Math.min(100, Math.max(0, ratio * 100))}%`;
      };
      update();
      window.addEventListener("scroll", update, { passive: true });
      window.addEventListener("resize", update);
    }

    // ---- 目录 TOC ----
    const tocList = document.querySelector<HTMLOListElement>(".toc-list");
    const postBody = document.querySelector<HTMLElement>(".post-body");
    if (tocList && postBody) {
      const headings = Array.from(
        postBody.querySelectorAll<HTMLElement>("h2, h3")
      ).filter((h) => h.id);

      // 只有标题足够多时才显示目录
      const nav = document.querySelector<HTMLElement>(".post-toc");
      if (nav) {
        nav.style.display = headings.length >= 2 ? "block" : "none";
      }

      tocList.innerHTML = "";
      const links: { link: HTMLAnchorElement; heading: HTMLElement }[] = [];

      headings.forEach((heading) => {
        const li = document.createElement("li");
        li.className = heading.tagName === "H3" ? "toc-sub" : "toc-top";
        const a = document.createElement("a");
        a.href = `#${heading.id}`;
        a.textContent = heading.textContent ?? "";
        li.appendChild(a);
        tocList.appendChild(li);
        links.push({ link: a, heading });
      });

      // 平滑滚动（带 sticky header 偏移）
      tocList.addEventListener("click", (e) => {
        const target = (e.target as HTMLElement).closest<HTMLAnchorElement>("a");
        if (!target) return;
        const id = target.getAttribute("href")?.slice(1);
        const el = id ? document.getElementById(id) : null;
        if (!el) return;
        e.preventDefault();
        const header = document.querySelector<HTMLElement>(".masthead-wrap");
        const offset = header ? header.offsetHeight : 0;
        const top = el.getBoundingClientRect().top + window.scrollY - offset - 16;
        window.scrollTo({ top, behavior: "smooth" });
      });

      // 滚动高亮当前章节
      const setActive = (id: string) => {
        links.forEach(({ link, heading }) => {
          link.classList.toggle("active", heading.id === id);
        });
      };
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) setActive(entry.target.id);
          }
        },
        { rootMargin: "-20% 0px -70% 0px", threshold: 0 }
      );
      headings.forEach((h) => observer.observe(h));
    }
  });
</script>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    z-index: 50;
    pointer-events: none;
  }

  .reading-progress-bar {
    height: 100%;
    width: 0;
    background-color: var(--accent);
    transition: width 0.1s linear;
  }

  /* ---- 目录 TOC ---- */
  .post-toc {
    display: none;
    margin: 32px 0 0;
    padding: 20px 24px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 4px;
  }

  .toc-label {
    margin: 0 0 10px;
    font-family: var(--sans);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  /* TOC 的 li/a 由 JS 动态创建，无 scoped 属性，须用 :global 才能命中 */
  .toc-list :global(li) {
    padding: 0;
    border: none;
  }

  .toc-list :global(a) {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.92rem;
    line-height: 1.5;
    border-left: 2px solid transparent;
    padding-left: 10px;
    margin-left: -10px;
    transition: color var(--t-base) ease, border-color var(--t-base) ease;
  }

  .toc-list :global(a:hover) {
    color: var(--accent);
  }

  .toc-list :global(a.active) {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  .toc-list :global(.toc-sub) {
    padding-left: 16px;
    font-size: 0.85rem;
  }

  .post {
    padding: 40px 0;
  }

  .post-header h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    margin: 8px 0 16px;
    letter-spacing: -0.02em;
  }

  .post-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    color: var(--text-muted);
    font-size: 0.9rem;
    font-variant-numeric: tabular-nums;
  }

  .reading-time {
    position: relative;
    padding-left: 12px;
  }

  .reading-time::before {
    content: "·";
    position: absolute;
    left: 2px;
    color: var(--border);
  }

  .updated-time {
    position: relative;
    padding-left: 12px;
    font-style: italic;
  }

  .updated-time::before {
    content: "·";
    position: absolute;
    left: 2px;
    color: var(--border);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    text-decoration: none;
    font-size: 0.72rem;
  }

  .tag:hover {
    text-decoration: none;
  }

  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 48px;
    padding-top: 28px;
    border-top: 1px solid var(--border);
  }

  .post-nav-item.next {
    text-align: right;
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
    color: var(--text);
  }

  .post-nav-link:hover .post-nav-title {
    color: var(--accent);
  }

  .post-nav-dir {
    font-family: var(--sans);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .post-nav-title {
    font-family: var(--serif);
    font-size: 1.15rem;
    transition: color var(--t-base) ease;
  }

  @media (max-width: 640px) {
    .post-nav {
      grid-template-columns: 1fr;
      gap: 16px;
    }

    .post-nav-item.next {
      text-align: left;
    }
  }

  .post-body {
    margin-top: 28px;
    font-family: "Noto Serif SC", var(--serif);
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .post-body :global(h2) {
    font-size: 1.6rem;
    margin: 1.8em 0 0.6em;
  }

  .post-body :global(h3) {
    font-size: 1.3rem;
    margin: 1.5em 0 0.5em;
  }

  .post-body :global(p) {
    margin: 0 0 1.2em;
    text-wrap: pretty;
  }

  .post-body :global(a) {
    color: var(--accent);
    text-decoration: none;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-size: 100% 1px;
    background-position: 0 100%;
    background-repeat: no-repeat;
    padding-bottom: 1px;
    transition: background-size var(--t-base) ease;
  }

  .post-body :global(a:hover) {
    background-size: 100% 2px;
  }

  /* ---- 相关文章 ---- */
  .related {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid var(--border);
  }

  .related-title {
    font-family: var(--serif);
    font-size: 1.4rem;
    margin: 4px 0 20px;
    letter-spacing: -0.01em;
  }

  .related-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .related-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 0;
    text-decoration: none;
    color: var(--text);
    border-bottom: 1px solid var(--border);
    transition: color var(--t-base) ease;
  }

  .related-list li:last-child .related-link {
    border-bottom: none;
  }

  .related-link:hover .related-post-title {
    color: var(--accent);
  }

  .related-meta {
    font-family: var(--sans);
    font-size: 0.78rem;
    letter-spacing: 0.05em;
    color: var(--text-muted);
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .related-tags {
    color: var(--accent);
  }

  .related-post-title {
    font-family: var(--serif);
    font-size: 1.1rem;
    line-height: 1.5;
    transition: color var(--t-base) ease;
  }

  @media (max-width: 640px) {
    .related {
      margin-top: 36px;
    }
  }
</style>
