---
import Base from "../layouts/Base.astro";

const gear = [
  {
    group: "硬件",
    items: [
      { k: "CPU", v: "AMD Ryzen 7 7840U，8 核低功耗，静音优先" },
      { k: "内存", v: "32GB LPDDR5，日常多开无压力" },
      { k: "显示器", v: "27 寸 4K 主屏 + 竖屏副屏放文档与终端" },
      { k: "键盘", v: "客制化 65% 机械键盘，茶轴，热插拔" },
      { k: "鼠标", v: "轻量无线鼠标，约 58g" },
      { k: "相机", v: "入门无反 + 35mm 定焦，扫街专用" },
    ],
  },
  {
    group: "软件",
    items: [
      { k: "系统", v: "Arch Linux + Hyprland 平铺窗口管理" },
      { k: "编辑器", v: "Neovim (LazyVim) + VS Code，共用一套配色" },
      { k: "终端", v: "zsh + bash，多套终端配置（alacritty/foot/ghostty/kitty）" },
      { k: "字体", v: "正文字体霞鹜文楷，代码 JetBrains Mono" },
      { k: "浏览器", v: "日常 Firefox，调试用 Chromium" },
      { k: "笔记", v: "纯文本 + Git 管理的本地知识库" },
    ],
  },
  {
    group: "AI 工具",
    items: [
      { k: "编码助手", v: "opencode + Codex + Claude Code，多 Agent 协作" },
      { k: "智能体", v: "Hermes Agent 用于代码审查与长任务拆步" },
      { k: "工具链", v: "mise 管理 Node/Go/Rust/Python 版本，统一环境" },
      { k: "版本控制", v: "Git + GitHub SSH，gh CLI 管理 PR/Issue" },
    ],
  },
  {
    group: "服务",
    items: [
      { k: "托管", v: "GitHub Pages 部署个人站点" },
      { k: "域名", v: "laizeyan.github.io（用户页）" },
      { k: "搜索", v: "Pagefind 站内全文检索" },
      { k: "CI", v: "GitHub Actions 自动构建与部署" },
      { k: "订阅", v: "RSS 输出，零第三方追踪" },
    ],
  },
];
---

<Base title="装备 · Ze'Yan" description="Ze'Yan 使用的工具与装备（Uses 页）">
  <article class="prose uses reveal">
    <header class="uses-head">
      <p class="section-kicker">装备</p>
      <h1>Uses</h1>
      <p class="lead">
        我日常依赖的工具与设备清单——受 uses.tech 启发的「在用」页面。
      </p>
    </header>

    <hr class="rule" />

    <div class="uses-body">
      {
        gear.map((section) => (
          <section class="uses-group">
            <h2>{section.group}</h2>
            <div class="uses-grid">
              {section.items.map((item) => (
                <div class="uses-card">
                  <span class="uses-k">{item.k}</span>
                  <span class="uses-v">{item.v}</span>
                </div>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </article>
</Base>

<style>
  .uses {
    padding: 40px 0;
  }

  .uses-head h1 {
    font-size: clamp(2.5rem, 8vw, 4.5rem);
    margin: 8px 0 16px;
    letter-spacing: -0.02em;
  }

  .uses-body {
    margin-top: 28px;
  }

  .uses-group {
    margin-bottom: 36px;
  }

  .uses-group h2 {
    font-size: 1.5rem;
    margin: 0 0 16px;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--border);
  }

  .uses-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 14px;
  }

  .uses-card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-left: 3px solid var(--accent);
    border-radius: 4px;
    padding: 14px 16px;
    transition: transform var(--t-base) ease, box-shadow var(--t-base) ease;
  }

  .uses-card:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 24px rgba(22, 20, 15, 0.08);
  }

  .uses-k {
    font-family: var(--sans);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--accent);
  }

  .uses-v {
    font-family: "Noto Serif SC", var(--serif);
    font-size: 0.98rem;
    line-height: 1.55;
    color: var(--text);
  }
</style>
