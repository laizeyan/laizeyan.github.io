---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const linkFor = (p: { data: { url?: string; repo?: string } }) =>
  p.data.url || p.data.repo || "#";
const hasLink = Boolean(project.data.url || project.data.repo);
---

<Base title={project.data.title} description={project.data.description}>
  <article class="prose project">
    <header class="project-header">
      <h1>{project.data.title}</h1>
      <div class="project-meta">
        {
          project.data.tags.length > 0 && (
            <span class="tags">
              {project.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </span>
          )
        }
        {
          hasLink && (
            <a
              class="project-link"
              href={linkFor(project)}
              target="_blank"
              rel="noopener"
            >
              {project.data.url ? "访问项目 →" : "查看仓库 →"}
            </a>
          )
        }
      </div>
    </header>
    <p class="lead">{project.data.description}</p>
    <div class="project-body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .project {
    padding: 32px 0;
  }

  .project-header h1 {
    font-size: 2.2rem;
    margin: 0 0 12px;
  }

  .project-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    margin-bottom: 24px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    font-size: 0.8rem;
    color: var(--text-muted);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 2px 10px;
  }

  .project-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .project-link:hover {
    text-decoration: underline;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--text-muted);
  }
</style>
