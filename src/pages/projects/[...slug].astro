---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug ?? project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);

const linkFor = (p: { data: { url?: string; repo?: string } }) =>
  p.data.url || p.data.repo || "#";
const hasLink = Boolean(project.data.url || project.data.repo);
---

<Base title={project.data.title} description={project.data.description}>
  <article class="prose project reveal">
    <header class="project-header">
      <p class="section-kicker">项目</p>
      <h1>{project.data.title}</h1>
      <div class="project-meta">
        {
          project.data.tags.length > 0 && (
            <span class="tags">
              {project.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </span>
          )
        }
        {
          hasLink && (
            <a
              class="project-link"
              href={linkFor(project)}
              target="_blank"
              rel="noopener"
            >
              {project.data.url ? "访问项目 →" : "查看仓库 →"}
            </a>
          )
        }
      </div>
    </header>
    <hr class="rule" />
    <p class="lead">{project.data.description}</p>
    <div class="project-body">
      <Content />
    </div>
  </article>
</Base>

<style>
  .project {
    padding: 40px 0;
  }

  .project-header h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    margin: 8px 0 16px;
    letter-spacing: -0.02em;
  }

  .project-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .tag {
    font-size: 0.72rem;
  }

  .project-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color var(--t-base) ease, transform var(--t-base) ease;
  }

  .project-link:hover {
    text-decoration: underline;
  }

  .project-link:active {
    transform: scale(0.98);
  }

  .lead {
    margin: 24px 0;
  }

  .project-body {
    font-family: "Noto Serif SC", var(--serif);
    font-size: 1.05rem;
    line-height: 1.85;
  }

  .project-body :global(h2) {
    font-size: 1.6rem;
    margin: 1.8em 0 0.6em;
  }

  .project-body :global(h3) {
    font-size: 1.3rem;
    margin: 1.5em 0 0.5em;
  }

  .project-body :global(p) {
    margin: 0 0 1.2em;
  }
</style>
