---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const linkFor = (p: { data: { url?: string; repo?: string } }) =>
  p.data.url || p.data.repo || "#";

const formatDate = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
---

<Base title="项目 · Ze'Yan" description="项目列表">
  <header class="page-head reveal">
    <p class="section-kicker">作品集</p>
    <h1>项目</h1>
    <p class="lead page-lead">一些我构建、维护或正在折腾的产品与工具。</p>
  </header>

  <hr class="rule" />

  <div class="grid reveal">
    {
      projects.map((project) => (
        <a
          class="card project-card"
          href={linkFor(project)}
          target="_blank"
          rel="noopener"
        >
          <span class="project-letter" aria-hidden="true">
            {project.data.title.charAt(0)}
          </span>
          <div class="project-card-body">
            <h3>{project.data.title}</h3>
            <p>{project.data.description}</p>
            <div class="tags">
              {project.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <div class="project-card-foot">
              <time class="project-date">{formatDate(project.data.date)}</time>
              <span class="card-link">
                {project.data.url ? "访问 →" : project.data.repo ? "仓库 →" : ""}
              </span>
            </div>
          </div>
        </a>
      ))
    }
  </div>
</Base>

<style>
  .page-head {
    padding: 40px 0 20px;
  }

  .page-head h1 {
    font-family: var(--serif);
    font-size: clamp(2.5rem, 7vw, 4rem);
    margin: 6px 0 12px;
    letter-spacing: -0.02em;
  }

  .page-lead {
    margin: 0;
    max-width: 560px;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 22px;
    margin-top: 32px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
  }

  .project-letter {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--accent-contrast);
    background-color: var(--accent);
    border-radius: 4px;
    margin-bottom: 16px;
  }

  .project-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-card-body h3 {
    margin: 0 0 8px;
    font-size: 1.25rem;
    color: var(--text);
  }

  .project-card-body > p {
    flex: 1;
  }

  .project-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
  }

  .project-date {
    color: var(--text-muted);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
  }

  .card-link {
    color: var(--accent);
    font-size: 0.9rem;
  }
</style>
