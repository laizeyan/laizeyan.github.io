---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const projects = (await getCollection("projects")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const linkFor = (p: { data: { url?: string; repo?: string } }) =>
  p.data.url || p.data.repo || "#";
const hasLink = (p: { data: { url?: string; repo?: string } }) =>
  Boolean(p.data.url || p.data.repo);

const formatDate = (d: Date) =>
  d.toLocaleDateString("zh-CN", {
    year: "numeric",
    month: "2-digit",
    day: "2-digit",
  });
---

<Base title="项目 · Ze'Yan" description="项目列表">
  <header class="page-head reveal">
    <p class="section-kicker">作品集</p>
    <h1>项目</h1>
    <p class="lead page-lead">一些我构建、维护或正在折腾的产品与工具。</p>
  </header>

  <hr class="rule" />

  <div class="grid reveal">
    {
      projects.map((project, i) => (
        <article class="card project-card">
          <span class="project-ghost-idx" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
          <span class="project-letter" aria-hidden="true">
            {project.data.title.charAt(0)}
          </span>
          <div class="project-card-body">
            <h3>
              <a class="detail-link" href={`/projects/${project.data.slug ?? project.id}`}>
                {project.data.title}
              </a>
            </h3>
            <p>{project.data.description}</p>
            <div class="tags">
              {project.data.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
            <div class="project-card-foot">
              <time class="project-date">{formatDate(project.data.date)}</time>
              <span class="card-actions">
                <a
                  class="card-link"
                  href={`/projects/${project.data.slug ?? project.id}`}
                >
                  详情 →
                </a>
                {
                  hasLink(project) && (
                    <a
                      class="external-link"
                      href={linkFor(project)}
                      target="_blank"
                      rel="noopener"
                    >
                      {project.data.url ? "外部 →" : "仓库 →"}
                    </a>
                  )
                }
              </span>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</Base>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 22px;
    margin-top: 32px;
  }

  .project-card {
    display: flex;
    flex-direction: column;
    position: relative;
    overflow: hidden;
  }

  /* 幽灵索引 — 大号半透明编号 */
  .project-ghost-idx {
    position: absolute;
    right: 16px;
    top: 12px;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 3rem;
    line-height: 1;
    color: var(--border);
    opacity: 0.5;
    user-select: none;
    pointer-events: none;
    letter-spacing: -0.03em;
  }

  .project-letter {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--accent-contrast);
    background-color: var(--accent);
    border-radius: 4px;
    margin-bottom: 16px;
    position: relative;
  }

  /* 内框装饰线 */
  .project-letter::after {
    content: "";
    position: absolute;
    inset: 3px;
    border: 1px solid color-mix(in srgb, var(--accent-contrast) 25%, transparent);
    border-radius: 2px;
    pointer-events: none;
  }

  .project-card-body {
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  .project-card-body h3 {
    margin: 0 0 8px;
    font-size: 1.25rem;
  }

  .detail-link {
    color: var(--text);
    text-decoration: none;
    transition: color var(--t-base) ease;
  }

  .detail-link:hover {
    color: var(--accent);
  }

  .project-card-body > p {
    flex: 1;
  }

  .project-card-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
    padding-top: 12px;
    border-top: 1px solid var(--border);
  }

  .project-date {
    color: var(--accent-2);
    font-size: 0.8rem;
    font-variant-numeric: tabular-nums;
    font-weight: 600;
  }

  .card-actions {
    display: flex;
    gap: 14px;
    align-items: center;
  }

  .card-link {
    color: var(--accent);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color var(--t-base) ease, transform var(--t-base) ease;
  }

  .card-link:hover {
    text-decoration: underline;
  }

  .external-link {
    color: var(--text-muted);
    font-size: 0.9rem;
    text-decoration: none;
    transition: color var(--t-base) ease;
  }

  .external-link:hover {
    color: var(--accent);
    text-decoration: underline;
  }
</style>
