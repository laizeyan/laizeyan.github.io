---
const year = new Date().getFullYear();

const columns = [
  {
    title: "栏目",
    links: [
      { href: "/blog", label: "博客" },
      { href: "/projects", label: "项目" },
      { href: "/about", label: "关于" },
      { href: "/now", label: "近况" },
      { href: "/uses", label: "装备" },
    ],
  },
  {
    title: "订阅",
    links: [
      { href: "/rss.xml", label: "RSS" },
      { href: "/search", label: "搜索" },
    ],
  },
  {
    title: "社交",
    links: [
      { href: "https://github.com/laizeyan", label: "GitHub" },
      { href: "mailto:hi@laizeyan.github.io", label: "Email" },
    ],
  },
];
---

<footer class="site-footer">
  <div class="page-container footer-inner">
    <div class="footer-brand">
      <a href="/" class="footer-name">Ze'Yan</a>
      <p class="footer-tag">前端工程师 · 产品构建者 · 写字的人</p>
    </div>
    <nav class="footer-cols" aria-label="页脚导航">
      {
        columns.map((col) => (
          <div class="footer-col">
            <h4>{col.title}</h4>
            <ul>
              {col.links.map((l) => (
                <li>
                  <a href={l.href}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>
  <div class="page-container footer-bottom">
    <span>© {year} Ze'Yan</span>
    <span class="footer-note">以 Astro 构建 · 编辑杂志风</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 80px;
    border-top: 1px solid var(--border);
    background-color: var(--bg-elevated);
    padding: 48px 0 28px;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    gap: 40px;
    justify-content: space-between;
  }

  .footer-name {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 1.6rem;
    color: var(--text);
    text-decoration: none;
  }

  .footer-name:hover {
    color: var(--accent);
  }

  .footer-tag {
    margin: 8px 0 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    max-width: 240px;
  }

  .footer-cols {
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
  }

  .footer-col h4 {
    font-family: var(--sans);
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--text-muted);
    margin: 0 0 12px;
  }

  .footer-col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .footer-col a {
    color: var(--text);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .footer-col a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 36px;
    padding-top: 18px;
    border-top: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
  }

  @media (max-width: 640px) {
    .footer-cols {
      gap: 28px;
    }
  }
</style>
