---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="page-container footer-inner">
    <p class="copyright">© {year} Ze'Yan</p>
    <nav class="social" aria-label="社交链接">
      <a href="https://github.com/laizeyan" rel="me">GitHub</a>
      <a href="https://github.com/laizeyan" rel="me">Email</a>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 64px;
    border-top: 1px solid var(--border);
    padding: 24px 0;
  }

  .footer-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
  }

  .copyright {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
  }

  .social {
    display: flex;
    gap: 16px;
  }

  .social a {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .social a:hover {
    color: var(--accent);
  }
</style>
