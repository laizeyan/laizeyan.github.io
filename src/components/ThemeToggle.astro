---
// src/components/ThemeToggle.astro
---

<button
  id="theme-toggle"
  type="button"
  class="theme-toggle"
  aria-label="切换明暗主题"
  title="切换明暗主题"
>
  <div class="icon-box">
    <!-- 暗色模式显示太阳 (点击切为亮色) -->
    <svg
      class="icon-sun"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"
      ></path>
    </svg>
    <!-- 亮色模式显示月亮 (点击切为暗色) -->
    <svg
      class="icon-moon"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        stroke-width="2"
        d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"
      ></path>
    </svg>
  </div>
</button>

<script>
  function setupThemeToggle() {
    const btn = document.getElementById("theme-toggle");
    if (!btn || btn.dataset.bound === "true") return;
    btn.dataset.bound = "true";

    btn.addEventListener("click", (e: MouseEvent) => {
      const root = document.documentElement;
      const isDark = root.dataset.theme === "dark";
      const next = isDark ? "light" : "dark";

      const isReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const startViewTransition = (document as any).startViewTransition;

      const toggleTheme = () => {
        root.dataset.theme = next;
        localStorage.setItem("theme", next);
      };

      if (!startViewTransition || isReducedMotion) {
        toggleTheme();
        return;
      }

      // 提取水波纹扩散中心点坐标（键盘触发则取按钮几何中心）
      const rect = btn.getBoundingClientRect();
      const x = e.clientX || rect.left + rect.width / 2;
      const y = e.clientY || rect.top + rect.height / 2;

      // 计算覆盖整个视口所需的最远对角线半径
      const endRadius = Math.hypot(
        Math.max(x, window.innerWidth - x),
        Math.max(y, window.innerHeight - y)
      );

      // 关键优化：在快照与扩散期间暂时阻断 DOM 内一切常规 CSS transition，释放主线程与 GPU
      root.classList.add("disable-transitions");

      const transition = startViewTransition.call(document, () => {
        toggleTheme();
      });

      transition.ready
        .then(() => {
          const clipPath = [
            `circle(0px at ${x}px ${y}px)`,
            `circle(${endRadius}px at ${x}px ${y}px)`,
          ];

          const animation = document.documentElement.animate(
            {
              clipPath: clipPath,
            },
            {
              duration: 460,
              easing: "cubic-bezier(0.4, 0, 0.2, 1)",
              pseudoElement: "::view-transition-new(root)",
            }
          );

          animation.onfinish = () => {
            root.classList.remove("disable-transitions");
          };
        })
        .catch(() => {
          root.classList.remove("disable-transitions");
        });

      transition.finished.finally(() => {
        root.classList.remove("disable-transitions");
      });
    });
  }

  document.addEventListener("astro:page-load", setupThemeToggle);
</script>

<style>
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--border);
    border-radius: 999px;
    background-color: transparent;
    color: var(--text-muted);
    cursor: pointer;
    transition:
      border-color var(--t-base) ease,
      color var(--t-base) ease,
      background-color var(--t-base) ease;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
    background-color: var(--bg-elevated);
  }

  .theme-toggle:active {
    transform: scale(0.92);
  }

  .icon-box {
    position: relative;
    width: 18px;
    height: 18px;
  }

  .icon-sun,
  .icon-moon {
    position: absolute;
    inset: 0;
  }

  /* 亮色模式：显示月亮，隐藏太阳 */
  .icon-sun {
    display: none;
  }
  .icon-moon {
    display: block;
  }

  /* 暗色模式：显示太阳，隐藏月亮 */
  :global([data-theme="dark"]) .icon-sun {
    display: block;
  }
  :global([data-theme="dark"]) .icon-moon {
    display: none;
  }
</style>
