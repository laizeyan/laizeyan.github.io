---
import ThemeToggle from "./ThemeToggle.astro";

const nav = [
  { href: "/", label: "首页" },
  { href: "/blog", label: "博客" },
  { href: "/projects", label: "项目" },
  { href: "/about", label: "关于" },
  { href: "/search", label: "搜索" },
];

const current = Astro.url.pathname;
---

<header class="site-header">
  <div class="page-container header-inner">
    <a href="/" class="site-name">Ze'Yan</a>
    <nav class="site-nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { active: current === item.href }]}
            aria-current={current === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <ThemeToggle />
    <a href="/rss.xml" class="rss-link" title="RSS 订阅" aria-label="RSS 订阅">RSS</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 16px;
    height: 60px;
  }

  .site-name {
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }

  .site-name:hover {
    text-decoration: none;
    color: var(--accent);
  }

  .site-nav {
    display: flex;
    gap: 18px;
    margin-left: auto;
  }

  .nav-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--accent);
  }

  .nav-link.active {
    font-weight: 600;
  }

  .rss-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.95rem;
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 2px 8px;
  }

  .rss-link:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  @media (max-width: 640px) {
    .site-nav {
      gap: 12px;
    }

    .nav-link {
      font-size: 0.88rem;
    }
  }
</style>
