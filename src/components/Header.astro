---
import ThemeToggle from "./ThemeToggle.astro";

const nav = [
  { href: "/", label: "首页" },
  { href: "/blog", label: "博客" },
  { href: "/archive", label: "归档" },
  { href: "/projects", label: "项目" },
  { href: "/about", label: "关于" },
  { href: "/now", label: "近况" },
  { href: "/uses", label: "装备" },
  { href: "/friends", label: "友链" },
];

const current = Astro.url.pathname;

const issueDate = new Date().toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
});
---

<header class="masthead-wrap">
  <div class="masthead-accent-bar" aria-hidden="true"></div>
  <div class="page-container">
    <div class="masthead-top">
      <a href="/" class="masthead-name">Ze'Yan</a>
      <div class="masthead-tools">
        <span class="masthead-issue">{issueDate}</span>
        <a href="/search" class="masthead-search" aria-label="搜索">搜索</a>
        <ThemeToggle />
      </div>
    </div>
    <div class="masthead-rule" aria-hidden="true">
      <span class="rule-line rule-thick"></span>
      <span class="rule-line rule-thin"></span>
    </div>
    <nav class="masthead-nav" aria-label="主导航">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { active: current === item.href }]}
            aria-current={current === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
      <a href="/rss.xml" class="nav-link rss" title="RSS 订阅" aria-label="RSS 订阅"
        >RSS</a
      >
    </nav>
  </div>
</header>

<style>
  .masthead-wrap {
    position: sticky;
    top: 0;
    z-index: 20;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  /* 顶部赭石红细条纹 */
  .masthead-accent-bar {
    height: 3px;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent) 60%, var(--accent-2) 100%);
  }

  .masthead-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0 10px;
  }

  .masthead-name {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 2.4rem;
    letter-spacing: -0.03em;
    color: var(--text);
    text-decoration: none;
    line-height: 1;
    transition: color var(--t-base) ease;
  }

  .masthead-name:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .masthead-name:active {
    transform: scale(0.98);
  }

  .masthead-tools {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .masthead-issue {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-left: 1px solid var(--border);
    padding-left: 14px;
  }

  .masthead-search {
    color: var(--text-muted);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--t-base) ease;
  }

  .masthead-search:hover {
    color: var(--accent);
  }

  /* 报刊双线规则 */
  .masthead-rule {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .rule-line {
    display: block;
    width: 100%;
  }

  .rule-thick {
    height: 2px;
    background-color: var(--text);
  }

  .rule-thin {
    height: 1px;
    background-color: var(--border);
  }

  .masthead-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 22px;
    padding: 8px 0 12px;
  }

  .nav-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.92rem;
    letter-spacing: 0.04em;
    position: relative;
    padding-bottom: 2px;
    transition: color var(--t-base) ease, transform var(--t-base) ease;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }

  .nav-link:active {
    transform: scale(0.98);
  }

  .nav-link.active {
    color: var(--accent);
  }

  .nav-link.active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background-color: var(--accent);
  }

  .rss {
    margin-left: auto;
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (max-width: 640px) {
    .masthead-name {
      font-size: 1.8rem;
    }

    .masthead-issue {
      display: none;
    }

    .masthead-nav {
      gap: 10px;
    }

    .nav-link {
      font-size: 0.85rem;
    }
  }
</style>
