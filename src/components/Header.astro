---
import ThemeToggle from "./ThemeToggle.astro";

const primaryNav = [
  { href: "/", label: "首页" },
  { href: "/blog", label: "博客" },
  { href: "/projects", label: "项目" },
  { href: "/trending", label: "热榜" },
  { href: "/tools", label: "工具" },
  { href: "/archive", label: "归档" },
];

const secondaryNav = [
  { href: "/now", label: "近况" },
  { href: "/uses", label: "装备" },
  { href: "/about", label: "关于" },
  { href: "/friends", label: "友链" },
];

const current = Astro.url.pathname;
const isActive = (href: string) => {
  if (href === "/") return current === "/";
  return current === href || current.startsWith(href + "/");
};

const issueDate = new Date().toLocaleDateString("zh-CN", {
  year: "numeric",
  month: "long",
});
---

<header class="masthead-wrap">
  <div class="masthead-accent-bar" aria-hidden="true"></div>
  <div class="page-container">
    <div class="masthead-top">
      <a href="/" class="masthead-name">Ze'Yan</a>
      <div class="masthead-tools">
        <span class="masthead-issue">{issueDate}</span>
        <a href="/search" class="masthead-search" aria-label="搜索">搜索</a>
        <ThemeToggle />
      </div>
    </div>
    <div class="masthead-rule" aria-hidden="true">
      <span class="rule-line rule-thick"></span>
      <span class="rule-line rule-thin"></span>
    </div>
    <nav class="masthead-nav" aria-label="主导航">
      <div class="nav-scroller">
        <div class="nav-group nav-primary">
          {
            primaryNav.map((item) => (
              <a
                href={item.href}
                class:list={["nav-link", { active: isActive(item.href) }]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
        <span class="nav-sep" aria-hidden="true"></span>
        <div class="nav-group nav-secondary">
          {
            secondaryNav.map((item) => (
              <a
                href={item.href}
                class:list={["nav-link", { active: isActive(item.href) }]}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {item.label}
              </a>
            ))
          }
        </div>
      </div>
      <a href="/rss.xml" class="nav-rss" title="RSS 订阅" aria-label="RSS 订阅">RSS</a>
    </nav>
  </div>
</header>

<style>
  .masthead-wrap {
    position: sticky;
    top: 0;
    z-index: 20;
    background-color: var(--bg);
    border-bottom: 1px solid var(--border);
  }

  /* 顶部赭石红细条纹 */
  .masthead-accent-bar {
    height: 3px;
    background: linear-gradient(90deg, var(--accent) 0%, var(--accent) 60%, var(--accent-2) 100%);
  }

  .masthead-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0 10px;
  }

  .masthead-name {
    font-family: var(--serif);
    font-weight: 700;
    font-size: 2.4rem;
    letter-spacing: -0.03em;
    color: var(--text);
    text-decoration: none;
    line-height: 1;
    transition: color var(--t-base) ease;
  }

  .masthead-name:hover {
    color: var(--accent);
    text-decoration: none;
  }

  .masthead-name:active {
    transform: scale(0.98);
  }

  .masthead-tools {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .masthead-issue {
    font-family: var(--sans);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--text-muted);
    border-left: 1px solid var(--border);
    padding-left: 14px;
  }

  .masthead-search {
    color: var(--text-muted);
    font-size: 0.82rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color var(--t-base) ease;
  }

  .masthead-search:hover {
    color: var(--accent);
  }

  /* 报刊双线规则 */
  .masthead-rule {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .rule-line {
    display: block;
    width: 100%;
  }

  .rule-thick {
    height: 2px;
    background-color: var(--text);
  }

  .rule-thin {
    height: 1px;
    background-color: var(--border);
  }

  .masthead-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 8px 0 10px;
    gap: 16px;
    position: relative;
  }

  .nav-scroller {
    display: flex;
    align-items: center;
    gap: 18px;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    -webkit-overflow-scrolling: touch;
    white-space: nowrap;
    flex: 1;
    padding: 2px 0 4px;
  }

  .nav-scroller::-webkit-scrollbar {
    display: none;
  }

  .nav-group {
    display: flex;
    align-items: center;
    gap: 18px;
    flex-shrink: 0;
  }

  .nav-sep {
    display: inline-block;
    width: 1px;
    height: 14px;
    background-color: var(--border);
    flex-shrink: 0;
    margin: 0 2px;
  }

  .nav-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.92rem;
    letter-spacing: 0.02em;
    position: relative;
    padding: 2px 1px;
    flex-shrink: 0;
    transition: color var(--t-base) ease, transform var(--t-base) ease;
    font-weight: 500;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }

  .nav-link:active {
    transform: scale(0.98);
  }

  .nav-link.active {
    color: var(--accent);
    font-weight: 600;
  }

  .nav-link.active::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 2px;
    background-color: var(--accent);
    border-radius: 1px;
  }

  .nav-rss {
    flex-shrink: 0;
    font-family: var(--sans);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-muted);
    text-decoration: none;
    padding: 2px 7px;
    border: 1px solid var(--border);
    border-radius: 3px;
    transition: all var(--t-base) ease;
  }

  .nav-rss:hover {
    color: var(--accent);
    border-color: var(--accent);
    background-color: var(--bg-elevated);
  }

  @media (max-width: 768px) {
    .nav-scroller {
      gap: 14px;
      mask-image: linear-gradient(90deg, black 0%, black calc(100% - 24px), transparent 100%);
      -webkit-mask-image: linear-gradient(90deg, black 0%, black calc(100% - 24px), transparent 100%);
      padding-right: 20px;
    }

    .nav-group {
      gap: 14px;
    }
  }

  @media (max-width: 640px) {
    .masthead-name {
      font-size: 1.8rem;
    }

    .masthead-issue {
      display: none;
    }

    .nav-link {
      font-size: 0.86rem;
    }
</style>
