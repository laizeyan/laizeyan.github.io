---
// src/components/tools/RegexTool.astro
---

<section class="tool-section" id="section-regex" style="display: none;">
  <div class="tool-header">
    <h2>正则表达式测试器</h2>
  </div>
  <div class="regex-input-box">
    <span class="regex-slash">/</span>
    <input type="text" id="regex-pattern" class="regex-pattern-input" value="[\w.-]+@[\w.-]+\.[a-zA-Z]{2,}" placeholder="输入正则表达式" />
    <span class="regex-slash">/</span>
    <input type="text" id="regex-flags" class="regex-flags-input" value="g" placeholder="flags" title="修饰符：g, i, m, s" />
  </div>

  <div class="regex-replace-box">
    <span class="regex-slash">➔</span>
    <input type="text" id="regex-replace-input" class="regex-pattern-input" placeholder="输入替换文本，支持 $1, $2 等捕获组..." />
    <button class="btn btn-sm btn-secondary" id="btn-regex-replace">执行替换</button>
    <button type="button" class="btn btn-sm btn-outline btn-layout-toggle" title="切换左右并排或上下堆叠">并排 ⇄ 堆叠</button>
  </div>

  <div class="regex-presets">
    <span class="preset-label">常用模板:</span>
    <button class="preset-btn" data-reg="^1[3-9]\d{9}$" data-flags="g" data-sample="客服电话：13800138000，备用联系号码：15912345678">中国大陆手机号</button>
    <button class="preset-btn" data-reg="[\w.-]+@[\w.-]+\.[a-zA-Z]{2,}" data-flags="g" data-sample="欢迎咨询 contact@example.com 或 feedback@service.cn">电子邮箱 Email</button>
    <button class="preset-btn" data-reg="https?:\/\/[^\s/$.?#].[^\s]*" data-flags="gi" data-sample="官方博客: https://laizeyan.github.io 开源主页: https://github.com/laizeyan">URL 网址</button>
    <button class="preset-btn" data-reg="\b(?:\d{1,3}\.){3}\d{1,3}\b" data-flags="g" data-sample="局域网网关 192.168.1.1 与公共 DNS 8.8.8.8">IPv4 地址</button>
    <button class="preset-btn" data-reg="[\u4e00-\u9fa5]+" data-flags="g" data-sample="极简杂志风 Minimal Magazine Design 2026 优雅设计">中文字符</button>
  </div>

  <div class="editor-grid">
    <div class="editor-col">
      <div class="pane-header">
        <span class="pane-tag">TEXT</span>
        <span class="col-kicker">待测试文本</span>
        <span class="pane-stats" id="regex-text-stats"></span>
      </div>
      <textarea id="regex-text" class="code-area" placeholder="在此输入待匹配的测试文本...">欢迎咨询 contact@example.com 或 feedback@service.cn</textarea>
    </div>
    <div class="editor-col">
      <div class="pane-header">
        <span class="pane-tag pane-tag-out">MATCHES</span>
        <span class="col-kicker">匹配捕获结果</span>
      </div>
      <div id="regex-matches-box" class="code-area code-result regex-results-box">
        <p class="text-muted">等待测试...</p>
      </div>
    </div>
  </div>
</section>
