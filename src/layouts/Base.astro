---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Ze'Yan · 个人站点",
  description = "Ze'Yan 的个人站点，记录博客、项目与关于。",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <meta property="og:site_name" content="Ze'Yan · 个人站点" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:image" content={new URL("/og-image.png", Astro.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Ze'Yan · 个人站点" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@laizeyan" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={new URL("/og-image.png", Astro.url).href} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="alternate" type="application/rss+xml" title="Ze'Yan · 博客" href="/rss.xml" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#b4452e" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index, follow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=Noto+Serif+SC:wght@400;600;700&display=swap"
    />

    <script is:inline>
      // 首屏前同步应用主题，避免闪现（FOUC）
      (function () {
        try {
          var stored = localStorage.getItem("theme");
          var theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
        } catch (e) {
          document.documentElement.dataset.theme = "light";
        }
      })();
    </script>
    <script>
      // View Transitions 导航后重新应用主题（模块脚本仅执行一次，监听 page-load 事件）
      document.addEventListener("astro:page-load", () => {
        try {
          const stored = localStorage.getItem("theme");
          const theme =
            stored === "light" || stored === "dark"
              ? stored
              : window.matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = "light";
        }
      });

      // 系统跟随：用户未手动选择时，实时响应系统主题切换
      try {
        const media = window.matchMedia("(prefers-color-scheme: dark)");
        const onSystemChange = () => {
          // 用户手动选过则不跟随
          const stored = localStorage.getItem("theme");
          if (stored === "light" || stored === "dark") return;
          document.documentElement.dataset.theme = media.matches
            ? "dark"
            : "light";
        };
        media.addEventListener("change", onSystemChange);
      } catch {
        // matchMedia change API 不可用时静默降级
      }
    </script>

    <ClientRouter />
  </head>
  <body>
    <div class="noise-overlay" aria-hidden="true"></div>
    <div class="frame-marks" aria-hidden="true"></div>
    <div class="watermark-layer" aria-hidden="true"><span class="wm-text">ZE'YAN</span></div>
    <div class="page-container">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>

    <script is:inline data-astro-rerun>
      (function () {
        var reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;
        var nodes = document.querySelectorAll(".reveal");
        if (reduce || !("IntersectionObserver" in window)) {
          nodes.forEach(function (n) {
            n.classList.add("is-visible");
          });
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                io.unobserve(entry.target);
              }
            });
          },
          { rootMargin: "0px 0px -10% 0px", threshold: 0.1 }
        );
        nodes.forEach(function (n) {
          io.observe(n);
        });
      })();
    </script>
  </body>
</html>
